<Window x:Class="Kashtrix.NRCS.AddBreakDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Break or Segment Header to Rundown"
        Width="500" Height="460"
        Background="#0D1117" Foreground="#F0F6FC"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        BorderBrush="#30363D" BorderThickness="1">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Content="✕" Width="30" Height="26" Click="Cancel_Click" Foreground="#FF7B72" Background="#21262D" BorderBrush="#30363D" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="DialogTitleText" Text="➕ INSERT BREAK / SEGMENT" FontSize="16" FontWeight="Bold" Foreground="#F59E0B"/>
                <Border Background="#1F2937" CornerRadius="3" Padding="6,2" Margin="10,0,0,0">
                    <TextBlock Text="RUNDOWN ARRANGER" FontSize="10" Foreground="#8B949E" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>
        </DockPanel>

        <!-- FORM -->
        <StackPanel Grid.Row="1">
            <!-- PRESETS -->
            <TextBlock Text="SELECT FROM PRESETS:" FontWeight="Bold" Foreground="#C9D1D9" FontSize="11" Margin="0,4,0,3"/>
            <ComboBox x:Name="PresetBox" Height="30" SelectionChanged="PresetBox_SelectionChanged" Margin="0,0,0,10"/>

            <!-- TITLE -->
            <TextBlock Text="TITLE / BLOCK NAME:" FontWeight="Bold" Foreground="#C9D1D9" FontSize="11" Margin="0,4,0,3"/>
            <TextBox x:Name="TitleBox" Height="28" Padding="6,4" Background="#161B22" Foreground="White" BorderBrush="#30363D" Margin="0,0,0,10"/>

            <!-- ITEM TYPE -->
            <TextBlock Text="ITEM CLASSIFICATION:" FontWeight="Bold" Foreground="#C9D1D9" FontSize="11" Margin="0,2,0,3"/>
            <ComboBox x:Name="BreakTypeBox" Height="30" SelectionChanged="BreakTypeBox_SelectionChanged" Margin="0,0,0,10">
                <ComboBoxItem Content="COMMERCIAL (Commercial Break)" Tag="BREAK"/>
                <ComboBoxItem Content="SEGMENT (Section Header / International, Sports, etc.)" Tag="SEGMENT"/>
                <ComboBoxItem Content="SPONSOR (Sponsor / Bumper Tag)" Tag="SPONSOR"/>
                <ComboBoxItem Content="STATION_ID (Station ID / Promo)" Tag="STATION_ID"/>
            </ComboBox>

            <!-- DURATION & SEGMENT -->
            <Grid Margin="0,4,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="DURATION (SECONDS):" FontWeight="Bold" Foreground="#C9D1D9" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="DurationBox" Text="60" Height="28" Padding="6,4" Background="#161B22" Foreground="White" BorderBrush="#30363D"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="SEGMENT LETTER:" FontWeight="Bold" Foreground="#C9D1D9" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="SegmentBox" Text="A" Height="28" Padding="6,4" Background="#161B22" Foreground="White" BorderBrush="#30363D"/>
                </StackPanel>
            </Grid>

            <!-- NOTES -->
            <TextBlock Text="PRODUCTION NOTES:" FontWeight="Bold" Foreground="#C9D1D9" FontSize="11" Margin="0,2,0,3"/>
            <TextBox x:Name="NotesBox" Height="45" AcceptsReturn="True" TextWrapping="Wrap" Padding="6,4" Background="#161B22" Foreground="White" BorderBrush="#30363D"/>
        </StackPanel>

        <!-- FOOTER ACTIONS -->
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="ErrorText" Foreground="#FF7B72" VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="INSERT INTO RUNDOWN" Click="Insert_Click" Padding="16,6" Background="#238636" Foreground="White" FontWeight="Bold" Margin="0,0,8,0"/>
                <Button Content="CANCEL" Click="Cancel_Click" Padding="14,6" Background="#21262D" BorderBrush="#30363D"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
