<Window x:Class="Kashtrix.NRCS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kashtrix NRCS" Width="1760" Height="990" MinWidth="1260" MinHeight="780"
        Background="{StaticResource Bg0Brush}" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Style="{StaticResource PanelBorder}" Padding="12,10" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="KASHTRIX NRCS" FontSize="22" FontWeight="Bold" Foreground="#E6C4FF"/>
                        <Border Background="#2B1A3F" CornerRadius="3" Padding="6,2" Margin="10,0,0,0">
                            <TextBlock Text="ENTERPRISE EDITION" FontSize="10" FontWeight="SemiBold" Foreground="#F0C8FF"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Integrated Newsroom Workflow: Planning · Gathering · Script · Media · CG · Rundown · Prompter · Playout" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- STATUS PILLS / ON AIR INDICATOR -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border x:Name="OnAirBadge" Background="#331A1A" BorderBrush="#882222" BorderThickness="1" CornerRadius="4" Padding="12,4" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="OnAirLed" Width="8" Height="8" Fill="#FF4444" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="OnAirText" Text="OFF AIR" Foreground="#FF9999" FontWeight="Bold" FontSize="11"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#161C26" BorderBrush="#253245" BorderThickness="1" CornerRadius="4" Padding="10,4">
                        <TextBlock x:Name="QuickStatsText" Text="Rundowns: 0 · Bank: 0 · Active: 0" Foreground="#8EB5DE" FontSize="11"/>
                    </Border>
                </StackPanel>

                <!-- TOP QUICK ACTIONS -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="+ ASSIGNMENT" Click="NewAssignment_Click" Margin="4,0"/>
                    <Button Content="+ STORY" Click="NewStory_Click" Margin="4,0"/>
                    <Button Content="+ RUNDOWN" Click="NewRundown_Click" Margin="4,0"/>
                    <Button Content="LOAD PROFESSIONAL DEMO" Click="LoadProfessionalDemo_Click" Margin="4,0" BorderBrush="{StaticResource AccentBrush}"/>
                    <Button Content="PROMPTER" Click="OpenPrompter_Click" Margin="4,0"/>
                    <Button Content="REFRESH" Click="Refresh_Click" Margin="4,0"/>
                </StackPanel>

                <!-- WINDOW CONTROLS -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Content="—" Width="32" Height="26" Click="Minimize_Click" ToolTip="Minimize"/>
                    <Button Content="□" Width="32" Height="26" Click="Maximize_Click" ToolTip="Maximize / Restore"/>
                    <Button Content="✕" Width="32" Height="26" Click="Close_Click" Foreground="#FF8D8D" ToolTip="Close"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN WORKSPACE TABS -->
        <TabControl Grid.Row="1" x:Name="WorkspaceTabs" Margin="0,10,0,10">

            <!-- TAB 0: NEWSROOM DASHBOARD -->
            <TabItem Header="DASHBOARD">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- TOP KPIS -->
                    <UniformGrid Columns="4" Margin="0,0,0,10">
                        <Border Style="{StaticResource PanelBorder}" Padding="14" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="ACTIVE RUNDOWNS" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold"/>
                                <TextBlock x:Name="DashRundownCountText" Text="1" FontSize="26" FontWeight="Bold" Foreground="#E6C4FF" Margin="0,4,0,0"/>
                                <TextBlock x:Name="DashRundownSubText" Text="KTX-PLAYOUT-01 · On Schedule" Foreground="#AAB2BD" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelBorder}" Padding="14" Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="READY STORIES" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold"/>
                                <TextBlock x:Name="DashStoriesReadyText" Text="12" FontSize="26" FontWeight="Bold" Foreground="#66E0A3" Margin="0,4,0,0"/>
                                <TextBlock x:Name="DashStoriesSubText" Text="Ready / Approved for Air" Foreground="#AAB2BD" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelBorder}" Padding="14" Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="OPEN ASSIGNMENTS" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold"/>
                                <TextBlock x:Name="DashAssignmentsText" Text="3" FontSize="26" FontWeight="Bold" Foreground="#FFD166" Margin="0,4,0,0"/>
                                <TextBlock x:Name="DashAssignmentsSubText" Text="Planned / In Progress" Foreground="#AAB2BD" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelBorder}" Padding="14" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="BROADCAST SUITE HEALTH" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold"/>
                                <TextBlock x:Name="DashHealthStatusText" Text="OPTIMAL" FontSize="26" FontWeight="Bold" Foreground="#66D9E8" Margin="0,4,0,0"/>
                                <TextBlock x:Name="DashHealthSubText" Text="Playout · CG · Prompter · MOS Linked" Foreground="#AAB2BD" FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- DASHBOARD SPLIT: RUN ORDERS & QUICK LIVE PREVIEW -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.8*"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: UPCOMING BULLETINS / RUNDOWNS -->
                        <Border Style="{StaticResource PanelBorder}" Padding="12" Margin="0,0,8,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="TODAY'S BULLETINS &amp; LIVE STATUS" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                                <DataGrid x:Name="DashboardRundownGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="DashboardRundownGrid_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="BULLETIN" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="CHANNEL" Binding="{Binding ChannelId}" Width="120"/>
                                        <DataGridTextColumn Header="AIR TIME (UTC)" Binding="{Binding AirDateUtc, StringFormat={}{0:HH:mm}}" Width="100"/>
                                        <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="90"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>

                        <!-- RIGHT: BREAKING NEWS FLASH & SYSTEM HEALTH SNAPSHOT -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Style="{StaticResource PanelBorder}" Padding="12" Margin="0,0,0,8" BorderBrush="#663300">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="#E65100" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                                            <TextBlock Text="URGENT" Foreground="White" FontWeight="Bold" FontSize="10"/>
                                        </Border>
                                        <TextBlock Text="NEWS FLASH &amp; BREAKING INGEST" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="DashBreakingHeadlineText" Text="Traffic &amp; public transit upgrades coordinated across city center junctions." FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,4"/>
                                    <TextBlock x:Name="DashBreakingAgencyText" Text="Source: National Desk · 14 mins ago" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Padding="12">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="INTEGRATED CONNECTOR STATUS" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>
                                    <DataGrid x:Name="ConnectorStatusGrid" AutoGenerateColumns="False" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="SYSTEM" Binding="{Binding Name}" Width="160"/>
                                            <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="90"/>
                                            <DataGridTextColumn Header="PROTOCOL / MESSAGE" Binding="{Binding Message}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 1: PLANNING & ASSIGNMENTS DIARY -->
            <TabItem Header="PLANNING / ASSIGNMENTS">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource PanelBorder}" Padding="12" Margin="0,0,8,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="NEWS DIARY &amp; CALENDAR" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="Forward coverage: Court, Government, Sports, Finance &amp; Conferences" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,8"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="SEARCH" Click="SearchDiary_Click" Margin="6,0,0,0"/>
                                    <TextBox x:Name="DiarySearchBox" KeyDown="DiarySearchBox_KeyDown"/>
                                </DockPanel>
                            </StackPanel>
                            <DataGrid x:Name="DiaryGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="DiaryGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="DATE" Binding="{Binding EventDateUtc, StringFormat={}{0:MM-dd HH:mm}}" Width="95"/>
                                    <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="90"/>
                                    <DataGridTextColumn Header="TITLE" Binding="{Binding Title}" Width="*"/>
                                    <DataGridTextColumn Header="LOCATION" Binding="{Binding Location}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Padding="14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="EVENT DETAILS &amp; ASSIGNMENT DISPATCH" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="Convert scheduled diary events into reporter assignments with one click." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,12"/>

                                <TextBlock Text="EVENT TITLE"/><TextBox x:Name="DiaryTitleBox"/>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,6,0"><TextBlock Text="CATEGORY"/><TextBox x:Name="DiaryCategoryBox"/></StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="LOCATION"/><TextBox x:Name="DiaryLocationBox"/></StackPanel>
                                </Grid>
                                <TextBlock Text="CONTACTS &amp; LOGISTICS" Margin="0,8,0,0"/><TextBox x:Name="DiaryContactsBox"/>
                                <TextBlock Text="DESCRIPTION &amp; EDITORIAL NOTES" Margin="0,8,0,0"/><TextBox x:Name="DiaryDescBox" Height="100" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Content="CONVERT TO ASSIGNMENT" Click="ConvertDiaryToAssignment_Click"/>
                                    <Button Content="+ NEW EVENT" Click="NewDiaryEvent_Click" Margin="8,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: ASSIGNMENT DESK -->
            <TabItem Header="ASSIGNMENTS">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource PanelBorder}" Padding="10" Margin="0,0,8,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="ASSIGNMENT DESK" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="AssignmentCountText" Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,5,0"><TextBlock Text="PLANNING VIEW" FontSize="10" Foreground="{StaticResource MutedBrush}"/><ComboBox x:Name="AssignmentFilterModeBox" SelectionChanged="AssignmentFilter_Changed"/></StackPanel>
                                    <StackPanel Grid.Column="1" Margin="5,0"><TextBlock Text="DAY" FontSize="10" Foreground="{StaticResource MutedBrush}"/><DatePicker x:Name="AssignmentDateFilter" SelectedDateChanged="AssignmentFilter_Changed"/></StackPanel>
                                    <Button Grid.Column="2" Content="TODAY" Click="AssignmentToday_Click" Margin="5,18,0,0" Padding="10,4"/>
                                </Grid>
                            </StackPanel>
                            <DataGrid x:Name="AssignmentGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="AssignmentGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="DUE" Binding="{Binding DueUtc, StringFormat={}{0:MM-dd HH:mm}}" Width="100"/>
                                    <DataGridTextColumn Header="TITLE" Binding="{Binding Title}" Width="*"/>
                                    <DataGridTextColumn Header="DESK" Binding="{Binding Desk}" Width="90"/>
                                    <DataGridTextColumn Header="ASSIGNEE" Binding="{Binding Assignee}" Width="120"/>
                                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="105"/>
                                    <DataGridTextColumn Header="PRIORITY" Binding="{Binding Priority}" Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Padding="14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="ASSIGNMENT EDITOR" FontSize="18" FontWeight="Bold"/>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Text="TITLE"/><TextBox x:Name="AssignmentTitleBox"/>
                                        <TextBlock Text="ASSIGNEE" Margin="0,10,0,0"/><TextBox x:Name="AssignmentAssigneeBox"/>
                                        <TextBlock Text="DESK" Margin="0,10,0,0"/><ComboBox x:Name="AssignmentDeskBox"/>
                                        <TextBlock Text="LOCATION" Margin="0,10,0,0"/><TextBox x:Name="AssignmentLocationBox"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="STATUS"/><ComboBox x:Name="AssignmentStatusBox"/>
                                        <TextBlock Text="PRIORITY" Margin="0,10,0,0"/><ComboBox x:Name="AssignmentPriorityBox"/>
                                        <TextBlock Text="DUE (LOCAL yyyy-MM-dd HH:mm)" Margin="0,10,0,0"/><TextBox x:Name="AssignmentDueBox"/>
                                        <TextBlock Text="LINKED STORY" Margin="0,10,0,0"/><ComboBox x:Name="AssignmentStoryBox" DisplayMemberPath="Slug" SelectedValuePath="Id"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="EDITORIAL ANGLE / BRIEF" Margin="0,12,0,4"/><TextBox x:Name="AssignmentAngleBox" Height="100" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                                <TextBlock Text="NOTES / CONTACTS / LOGISTICS" Margin="0,12,0,4"/><TextBox x:Name="AssignmentNotesBox" Height="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Content="SAVE ASSIGNMENT" Click="SaveAssignment_Click"/>
                                    <Button Content="CREATE STORY FROM ASSIGNMENT" Click="CreateStoryFromAssignment_Click" Margin="8,0,0,0"/>
                                    <Button Content="DELETE" Click="DeleteAssignment_Click" Margin="8,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 3: NEWS GATHERING & WIRE FEEDS -->
            <TabItem Header="WIRES / INGEST">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.7*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource PanelBorder}" Padding="12" Margin="0,0,8,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="MULTI-AGENCY WIRE SERVICE" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="Reuters · Associated Press · National Desk · Sports Wire" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,8"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="SEARCH" Click="SearchWires_Click" Margin="6,0,0,0"/>
                                    <TextBox x:Name="WireSearchBox" KeyDown="WireSearchBox_KeyDown"/>
                                </DockPanel>
                            </StackPanel>
                            <DataGrid x:Name="WireGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="WireGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="TIME" Binding="{Binding PublishedUtc, StringFormat={}{0:HH:mm}}" Width="65"/>
                                    <DataGridTextColumn Header="AGENCY" Binding="{Binding Agency}" Width="110"/>
                                    <DataGridTextColumn Header="URGENCY" Binding="{Binding Urgency}" Width="80"/>
                                    <DataGridTextColumn Header="HEADLINE" Binding="{Binding Headline}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock x:Name="WireArticleHeadline" Text="Select a wire dispatch" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock x:Name="WireArticleMeta" Text="Agency · Timestamp · Category" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,10"/>
                            </StackPanel>

                            <TextBox Grid.Row="1" x:Name="WireArticleBody" AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontSize="13" Padding="8"/>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="CONVERT WIRE TO STORY DRAFT" Click="ConvertWireToStory_Click"/>
                                <Button Content="REFRESH WIRES" Click="RefreshWires_Click" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 4: STORY DESK & PROFESSIONAL SCRIPT EDITOR -->
            <TabItem Header="STORY DESK">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="380"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource PanelBorder}" Padding="10" Margin="0,0,8,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="STORY BANK" FontWeight="Bold"/>
                                <DockPanel Margin="0,8"><Button DockPanel.Dock="Right" Content="SEARCH" Click="SearchStories_Click" Margin="8,0,0,0"/><TextBox x:Name="StorySearchBox" KeyDown="StorySearchBox_KeyDown"/></DockPanel>
                            </StackPanel>
                            <DataGrid x:Name="StoryBankGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="StoryBankGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="SLUG" Binding="{Binding Slug}" Width="*"/>
                                    <DataGridTextColumn Header="TYPE" Binding="{Binding StoryType}" Width="70"/><DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="90"/>
                                    <DataGridTextColumn Header="PRI" Binding="{Binding Priority}" Width="60"/>
                                    <DataGridTextColumn Header="PRESENTER" Binding="{Binding Presenter}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <DockPanel>
                                <StackPanel>
                                    <TextBlock Text="STORY EDITOR" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock x:Name="ScriptTimingStatsText" Text="Words: 0 · Estimated Read Duration: 0 sec" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="AI ASSISTANT" Click="AiAssist_Click" Margin="0,0,8,0" BorderBrush="{StaticResource AccentBrush}"/>
                                    <Button Content="ADD TO RUNDOWN" Click="AddStoryToRundown_Click"/>
                                    <Button Content="SAVE" Click="SaveStory_Click" Margin="8,0,0,0"/>
                                    <Button Content="DELETE" Click="DeleteStory_Click" Margin="8,0,0,0"/>
                                </StackPanel>
                            </DockPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,6,0"><TextBlock Text="SLUG"/><TextBox x:Name="SlugBox"/><TextBlock Text="PRESENTER" Margin="0,8,0,0"/><TextBox x:Name="PresenterBox"/><TextBlock Text="WRITER" Margin="0,8,0,0"/><TextBox x:Name="WriterBox"/></StackPanel>
                                        <StackPanel Grid.Column="1" Margin="6,0"><TextBlock Text="STATUS"/><ComboBox x:Name="StoryStatusBox"/><TextBlock Text="EDITOR" Margin="0,8,0,0"/><TextBox x:Name="EditorBox"/><TextBlock Text="CATEGORY / DESK" Margin="0,8,0,0"/><ComboBox x:Name="StoryCategoryBox"/></StackPanel>
                                        <StackPanel Grid.Column="2" Margin="6,0,0,0"><TextBlock Text="PRIORITY"/><ComboBox x:Name="StoryPriorityBox"/><TextBlock Text="STORY / MOS TYPE" Margin="0,8,0,0"/><ComboBox x:Name="StoryTypeBox"/><TextBlock Text="DURATION (SEC)" Margin="0,8,0,0"/><TextBox x:Name="DurationBox" Text="30"/><TextBlock Text="LANGUAGE (en / ne)" Margin="0,8,0,0"/><TextBox x:Name="LanguageBox" Text="en"/></StackPanel>
                                    </Grid>

                                    <!-- BROADCAST PRODUCTION SECTION / CATEGORY CUES (OCTOPUS & EASY NRCS STANDARD) -->
                                    <Border Background="#161C24" BorderBrush="#263445" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,12,0,6">
                                        <DockPanel>
                                            <TextBlock Text="SCRIPT SECTION / CUE:" Foreground="#A0B0C0" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <WrapPanel VerticalAlignment="Center">
                                                <Button Content="[OC]" Click="InsertCue_Click" Tag="[OC] " Background="#1E293B" Foreground="#94A3B8" BorderBrush="#475569" FontWeight="Bold" Padding="7,3" Margin="2,1" ToolTip="On-Camera Presenter Copy"/>
                                                <Button Content="[ANCHOR]" Click="InsertCue_Click" Tag="[ANCHOR] " Background="#1E3A8A" Foreground="#93C5FD" BorderBrush="#3B82F6" FontWeight="Bold" Padding="7,3" Margin="2,1" ToolTip="Anchor Read / Copy (Sent to Prompter)"/>
                                                <Button Content="[INTRO]" Click="InsertCue_Click" Tag="[INTRO] " Background="#2E1065" Foreground="#DDD6FE" BorderBrush="#7C3AED" FontWeight="Bold" Padding="7,3" Margin="2,1" ToolTip="Lead-In / Package Intro"/>
                                                <Button Content="[VO]" Click="InsertCue_Click" Tag="[VO] " Background="#14532D" Foreground="#86EFAC" BorderBrush="#22C55E" FontWeight="Bold" Padding="7,3" Margin="2,1" ToolTip="Voice-Over with Video"/>
                                                <Button Content="[SOT]" Click="InsertCue_Click" Tag="[SOT IN] " Background="#78350F" Foreground="#FDE68A" BorderBrush="#F59E0B" FontWeight="Bold" Padding="7,3" Margin="2,1" ToolTip="Sound on Tape (Interview Clip)"/>
                                                <Button Content="[VO/SOT]" Click="InsertCue_Click" Tag="[VO/SOT] " Background="#713F12" Foreground="#FEF08A" BorderBrush="#CA8A04" FontWeight="Bold" Padding="7,3" Margin="2,1" ToolTip="Voice-Over followed by SOT"/>
                                                <Button Content="[PKG]" Click="InsertCue_Click" Tag="[PKG IN] " Background="#581C87" Foreground="#D8B4FE" BorderBrush="#A855F7" FontWeight="Bold" Padding="7,3" Margin="2,1" ToolTip="Full Edited Reporter Package"/>
                                                <Button Content="[LIVE]" Click="InsertCue_Click" Tag="[LIVE REPORTER] " Background="#7F1D1D" Foreground="#FCA5A5" BorderBrush="#EF4444" FontWeight="Bold" Padding="7,3" Margin="2,1" ToolTip="Live Remote / Reporter Segment"/>
                                                <Button Content="[CG]" Click="InsertCue_Click" Tag="[CG CUE] " Background="#134E4A" Foreground="#99F6E4" BorderBrush="#14B8A6" FontWeight="Bold" Padding="7,3" Margin="2,1" ToolTip="Lower Third / Full Screen Graphic Cue"/>
                                                <Button Content="[DIRECTOR]" Click="InsertCue_Click" Tag="[DIRECTOR NOTE: " Background="#831843" Foreground="#FBCFE8" BorderBrush="#DB2777" FontWeight="Bold" Padding="7,3" Margin="2,1" ToolTip="Director Technical Cue (Hidden from Prompter)"/>
                                                <Button Content="[PRODUCER]" Click="InsertCue_Click" Tag="[PRODUCER NOTE: " Background="#4C1D95" Foreground="#E9D5FF" BorderBrush="#9333EA" FontWeight="Bold" Padding="7,3" Margin="2,1" ToolTip="Editorial Note (Hidden from Prompter)"/>
                                                <Button Content="[BREAK]" Click="InsertCue_Click" Tag="[COMMERCIAL BREAK] " Background="#374151" Foreground="#E5E7EB" BorderBrush="#6B7280" FontWeight="Bold" Padding="7,3" Margin="2,1" ToolTip="Commercial Break"/>
                                            </WrapPanel>
                                        </DockPanel>
                                    </Border>

                                    <!-- WORD-LIKE FORMATTING TOOLBAR & SCRIPT TIMING -->
                                    <Border Background="#121720" BorderBrush="#263445" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                                        <WrapPanel VerticalAlignment="Center">
                                            <!-- FONT FAMILY -->
                                            <TextBlock Text="Font:" Foreground="#8D969E" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" FontWeight="SemiBold"/>
                                            <ComboBox x:Name="EditorFontFamilyBox" Width="230" Height="28"
                                                      SelectionChanged="EditorFontFamily_SelectionChanged"
                                                      Margin="0,0,10,0" ToolTip="Installed System Fonts">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Source}" FontFamily="{Binding}" FontSize="12" VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>

                                            <!-- FONT SIZE -->
                                            <TextBlock Text="Size:" Foreground="#8D969E" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" FontWeight="SemiBold"/>
                                            <ComboBox x:Name="EditorFontSizeBox" Width="68" Height="28" SelectionChanged="EditorFontSize_SelectionChanged" Margin="0,0,10,0">
                                                <ComboBoxItem Content="11"/>
                                                <ComboBoxItem Content="12"/>
                                                <ComboBoxItem Content="13"/>
                                                <ComboBoxItem Content="14"/>
                                                <ComboBoxItem Content="15" IsSelected="True"/>
                                                <ComboBoxItem Content="16"/>
                                                <ComboBoxItem Content="18"/>
                                                <ComboBoxItem Content="20"/>
                                                <ComboBoxItem Content="22"/>
                                                <ComboBoxItem Content="24"/>
                                                <ComboBoxItem Content="28"/>
                                                <ComboBoxItem Content="32"/>
                                                <ComboBoxItem Content="36"/>
                                            </ComboBox>

                                            <!-- STYLES -->
                                            <Button x:Name="BoldBtn" Content="B" FontFamily="Segoe UI" FontWeight="Bold" FontSize="13" Width="28" Height="28" Click="ToggleBold_Click" ToolTip="Bold (Selection or Caret)" Margin="0,0,3,0"/>
                                            <Button x:Name="ItalicBtn" Content="I" FontFamily="Segoe UI" FontStyle="Italic" FontWeight="Bold" FontSize="13" Width="28" Height="28" Click="ToggleItalic_Click" ToolTip="Italic (Selection or Caret)" Margin="0,0,3,0"/>
                                            <Button x:Name="UnderlineBtn" Width="28" Height="28" Click="ToggleUnderline_Click" ToolTip="Underline (Selection or Caret)" Margin="0,0,3,0">
                                                <TextBlock Text="U" FontFamily="Segoe UI" TextDecorations="Underline" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Button>
                                            <Button x:Name="StrikeBtn" Width="28" Height="28" Click="ToggleStrike_Click" ToolTip="Strikethrough (Selection or Caret)" Margin="0,0,8,0">
                                                <TextBlock Text="S" FontFamily="Segoe UI" TextDecorations="Strikethrough" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Button>

                                            <!-- TEXT COLOR PICKER -->
                                            <TextBlock Text="Color:" Foreground="#8D969E" VerticalAlignment="Center" Margin="2,0,6,0" FontSize="12" FontWeight="SemiBold"/>
                                            <ComboBox x:Name="EditorTextColorBox" Width="95" Height="28" SelectionChanged="EditorTextColor_SelectionChanged" Margin="0,0,8,0">
                                                <ComboBoxItem Content="White" IsSelected="True"/>
                                                <ComboBoxItem Content="Yellow"/>
                                                <ComboBoxItem Content="Cyan"/>
                                                <ComboBoxItem Content="Green"/>
                                                <ComboBoxItem Content="Orange"/>
                                                <ComboBoxItem Content="Pink"/>
                                                <ComboBoxItem Content="Light Blue"/>
                                                <ComboBoxItem Content="Red"/>
                                            </ComboBox>

                                            <!-- HIGHLIGHT PICKER -->
                                            <TextBlock Text="Highlight:" Foreground="#8D969E" VerticalAlignment="Center" Margin="2,0,6,0" FontSize="12" FontWeight="SemiBold"/>
                                            <ComboBox x:Name="EditorBgColorBox" Width="95" Height="28" SelectionChanged="EditorBgColor_SelectionChanged" Margin="0,0,10,0">
                                                <ComboBoxItem Content="None" IsSelected="True"/>
                                                <ComboBoxItem Content="Yellow"/>
                                                <ComboBoxItem Content="Cyan"/>
                                                <ComboBoxItem Content="Dark Blue"/>
                                                <ComboBoxItem Content="Dark Red"/>
                                                <ComboBoxItem Content="Dark Green"/>
                                                <ComboBoxItem Content="Charcoal"/>
                                            </ComboBox>

                                            <!-- RESET FORMATTING -->
                                            <Button Content="RESET" Click="ResetFormatting_Click" ToolTip="Reset formatting on selection to default" Padding="10,0" Height="28" Background="#261A1D" BorderBrush="#593037" Foreground="#F5A3B0" FontSize="11" FontWeight="SemiBold" Margin="0,0,10,0"/>

                                            <!-- DYNAMIC READING RATE WPM SLIDER -->
                                            <TextBlock Text="WPM:" Foreground="#66D9E8" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,6,0" FontSize="12"/>
                                            <Slider x:Name="ReadingRateSlider" Minimum="100" Maximum="200" Value="140" Width="80" Height="28" VerticalAlignment="Center" ValueChanged="ReadingRateSlider_ValueChanged" ToolTip="Anchor reading speed in Words Per Minute"/>
                                            <TextBlock x:Name="ReadingRateValueText" Text="140 WPM" Foreground="#66D9E8" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"/>
                                            <CheckBox x:Name="AutoSyncDurationCheck" Content="Auto-Sync Duration" Foreground="#AAB2BD" IsChecked="True" VerticalAlignment="Center" ToolTip="Automatically update DURATION based on WPM rate" Margin="4,0,0,0" FontSize="11"/>
                                        </WrapPanel>
                                    </Border>

                                    <DockPanel Margin="0,4,0,4">
                                        <TextBlock Text="SCRIPT / PROMPTER BODY" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <RichTextBox x:Name="BodyRichBox" Height="240" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" SpellCheck.IsEnabled="True" TextChanged="BodyRichBox_TextChanged" SelectionChanged="BodyRichBox_SelectionChanged" FontFamily="Segoe UI, Mangal, Nirmala UI" FontSize="15" Background="#14181F" Foreground="#E7EAED" Padding="10">
                                        <FlowDocument PagePadding="2"/>
                                    </RichTextBox>
                                    <TextBlock Text="PRIVATE STORY NOTES (NOT PROMPTED)" Margin="0,10,0,4"/><TextBox x:Name="StoryNotesBox" AcceptsReturn="True" Height="65" TextWrapping="Wrap"/>
                                    <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,6,0"><TextBlock Text="MEDIA / MAM MASTER PATH"/><DockPanel><Button Content="BROWSE" DockPanel.Dock="Right" Click="BrowseMedia_Click" Margin="8,0,0,0"/><TextBox x:Name="MediaPathBox"/></DockPanel><TextBlock Text="CG TEMPLATE / PROJECT" Margin="0,8,0,0"/><ComboBox x:Name="CgTemplateBox" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True" SelectionChanged="CgTemplateBox_SelectionChanged"/><TextBlock x:Name="CgTemplateInfoText" Text="Choose from the canonical 200-template catalog." FontSize="10" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="CG LAYER / Z-ORDER"/><ComboBox x:Name="CgLayerBox" IsEditable="True" Text="20"/><TextBlock Text="CG DATA JSON" Margin="0,8,0,0"/><TextBox x:Name="CgDataBox" AcceptsReturn="True" Height="90" Text="{}" FontFamily="Consolas"/></StackPanel>
                                    </Grid>
                                    <DockPanel Margin="0,12,0,4">
                                        <TextBlock Text="REVISION HISTORY" FontWeight="Bold"/>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <TextBlock x:Name="VersionCompareText" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <Button Content="RESTORE SELECTED REVISION" Click="RestoreRevision_Click"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <DataGrid x:Name="VersionGrid" Height="110" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="VersionGrid_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="VER" Binding="{Binding VersionId}" Width="55"/><DataGridTextColumn Header="TIME" Binding="{Binding CreatedUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="160"/><DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="90"/><DataGridTextColumn Header="WRITER" Binding="{Binding Writer}" Width="100"/><DataGridTextColumn Header="SLUG" Binding="{Binding Slug}" Width="*"/></DataGrid.Columns></DataGrid>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,5,0"><TextBlock Text="CURRENT SCRIPT" FontSize="10" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="CurrentRevisionBodyBox" Height="80" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/></StackPanel>
                                        <StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="SELECTED REVISION" FontSize="10" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="SelectedRevisionBodyBox" Height="80" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/></StackPanel>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 5: RUNDOWN & LIVE PRODUCTION -->
            <TabItem Header="RUNDOWN / LIVE">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource PanelBorder}" Padding="10" Margin="0,0,8,0"><DockPanel><TextBlock DockPanel.Dock="Top" Text="RUNDOWNS" FontWeight="Bold" Margin="0,0,0,8"/><ListBox x:Name="RundownList" DisplayMemberPath="Name" SelectionChanged="RundownList_SelectionChanged"/></DockPanel></Border>
                    <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Padding="10" Margin="0,0,8,0">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="RundownHeader" Text="SELECT A RUNDOWN" FontWeight="Bold"/><TextBlock x:Name="RundownTimingText" Foreground="{StaticResource MutedBrush}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="▲" Width="42" Click="MoveUp_Click"/><Button Content="▼" Width="42" Margin="5,0,0,0" Click="MoveDown_Click"/><Button Content="REMOVE" Margin="5,0,0,0" Click="RemoveRundownItem_Click"/></StackPanel></Grid>
                            <DataGrid x:Name="RundownGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="RundownGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Sequence}" Width="38"/>
                                    <DataGridTextColumn Header="START" Binding="{Binding PlannedStartUtc, StringFormat={}{0:HH:mm:ss}}" Width="75"/>
                                    <DataGridTextColumn Header="END" Binding="{Binding PlannedEndUtc, StringFormat={}{0:HH:mm:ss}}" Width="75"/>
                                    <DataGridTextColumn Header="SEG" Binding="{Binding Segment}" Width="48"/>
                                    <DataGridTextColumn Header="SLUG" Binding="{Binding Slug}" Width="*"/>
                                    <DataGridTextColumn Header="TYPE" Binding="{Binding StoryType}" Width="65"/>
                                    <DataGridTextColumn Header="PRESENTER" Binding="{Binding Presenter}" Width="105"/>
                                    <DataGridTextColumn Header="DUR" Binding="{Binding DurationSeconds}" Width="55"/>
                                    <DataGridCheckBoxColumn Header="SKIP" Binding="{Binding IsSkipped}" Width="55"/>
                                    <DataGridCheckBoxColumn Header="LIVE" Binding="{Binding IsLive}" Width="50"/>
                                    <DataGridTextColumn Header="MODE" Binding="{Binding StartMode}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="12">
                        <StackPanel>
                            <TextBlock Text="RUNDOWN ITEM" FontSize="17" FontWeight="Bold"/>
                            <TextBlock x:Name="RundownItemSlug" Text="No item selected" Foreground="#E6C4FF" FontSize="15" Margin="0,8,0,10" TextWrapping="Wrap"/>
                            <TextBlock Text="SEGMENT"/><TextBox x:Name="SegmentBox" Text="A"/>
                            <TextBlock Text="START MODE" Margin="0,8,0,0"/><ComboBox x:Name="StartModeBox"/>
                            <TextBlock Text="ITEM STATUS" Margin="0,8,0,0"/><ComboBox x:Name="ItemStatusBox"/>
                            <CheckBox x:Name="SkipCheck" Content="SKIP / CLOAK FROM AIR" Margin="0,12,0,0"/>
                            <CheckBox x:Name="LockCheck" Content="LOCK RUNDOWN ITEM" Margin="0,8,0,0"/>
                            <Button Content="SAVE ITEM SETTINGS" Click="SaveRundownItem_Click" Margin="0,12,0,0"/>
                            <Separator Margin="0,14"/>
                            <Button Content="TAKE SELECTED STORY LIVE" Click="TakeLive_Click"/>
                            <CheckBox x:Name="AutoAirCheck" Content="AUTO PLAYOUT + PROGRAM CG ON LIVE" IsChecked="True" Foreground="#E6C4FF" Margin="0,8,0,0"/>
                            <Button Content="NEXT STORY LIVE" Click="NextLive_Click" Margin="0,8,0,0"/>
                            <Button Content="CLEAR ON-AIR STATE" Click="ClearLive_Click" Margin="0,8,0,0"/>
                            <TextBlock x:Name="LiveStateText" Text="OFF AIR" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            <Separator Margin="0,14"/>
                            <Button Content="PUBLISH TO PLAYOUT" Click="PublishPlayout_Click"/>
                            <Button Content="PUBLISH MOS / NCS" Click="PublishMos_Click" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 6: INTEGRATION / STATUS -->
            <TabItem Header="INTEGRATION / STATUS">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource PanelBorder}" Padding="14" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="INTEGRATED BROADCAST PRODUCTION SUITE" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="MOS / NCS TRANSIT" Margin="0,12,0,0" FontWeight="Bold"/>
                            <TextBlock Text="Rundown stories generate structured roCreate MOS XML items (media clips and CG graphics) and transport via Automation Gateway." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Text="PLAYOUT ENGINE INTEGRATION" Margin="0,12,0,0" FontWeight="Bold"/>
                            <TextBlock Text="Rundowns translate into CLIP, VO, SOT, and LIVE playout events, persisting to shared database and signaling reload_playlist over IPC control bus." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Text="PROMPTER LIVE STATE" Margin="0,12,0,0" FontWeight="Bold"/>
                            <TextBlock Text="Shared SQLite WAL table 'nrcs_live_state' synchronizes the active story, script text, bookmarks, and on-air tally in real time." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="NEWSROOM WORKFLOW CAPABILITIES" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="• Role-based Dashboard with KPI tracking and live bulletin status&#x0a;• Planning Diary for forward events and one-click assignment creation&#x0a;• Multi-agency Wire Ingest (Reuters, AP, National Desk) with story conversion&#x0a;• AI Editorial Assistant for headlines, summaries, and keyword tags&#x0a;• Production cues ([ANCHOR], [PKG], [SOT], [VO], [LIVE], [CG])&#x0a;• Script reading speed calculation (WPM &amp; duration estimation)&#x0a;• English and Nepali/Devanagari Unicode multilingual workflow&#x0a;• Live-story state shared with Prompter engine and Playout bus" Margin="0,12,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Padding="10">
            <DockPanel>
                <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="DbText" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
