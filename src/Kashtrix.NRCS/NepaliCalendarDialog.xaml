<Window x:Class="Kashtrix.NRCS.NepaliCalendarDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nepali Calendar &amp; Date System Settings"
        Width="780" Height="680"
        Background="#0D1117" Foreground="#F0F6FC"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        BorderBrush="#30363D" BorderThickness="1">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TITLE BAR -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Content="✕" Width="30" Height="26" Click="Close_Click" Foreground="#FF7B72" Background="#21262D" BorderBrush="#30363D" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🇳🇵 NEPALI CALENDAR (BIKRAM SAMBAT)" FontSize="17" FontWeight="Bold" Foreground="#79C0FF"/>
                <Border Background="#1F2937" CornerRadius="3" Padding="6,2" Margin="10,0,0,0">
                    <TextBlock Text="AD / BS BROADCAST DATE ENGINE" FontSize="10" Foreground="#8B949E" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>
        </DockPanel>

        <!-- MAIN BODY -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- TODAY'S LIVE BANNER -->
                <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="TODAY'S BROADCAST DATE (BS)" FontSize="11" Foreground="#8B949E" FontWeight="Bold"/>
                            <TextBlock x:Name="TodayBsText" Text="२०८१ असोज १७, बिहिबार" FontSize="20" FontWeight="Bold" Foreground="#58A6FF" Margin="0,3,0,0"/>
                            <TextBlock x:Name="TodayAdText" Text="Gregorian: 2024-10-03 (Thursday)" FontSize="12" Foreground="#8B949E" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="TODAY" Click="Today_Click" Padding="14,6" VerticalAlignment="Center" Background="#238636" Foreground="White" FontWeight="Bold"/>
                    </Grid>
                </Border>

                <!-- CALENDAR EXPLORER & MONTH VIEW -->
                <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Left" Content="◀ PREV" Width="70" Height="28" Click="PrevMonth_Click" Background="#21262D" BorderBrush="#30363D"/>
                            <Button DockPanel.Dock="Right" Content="NEXT ▶" Width="70" Height="28" Click="NextMonth_Click" Background="#21262D" BorderBrush="#30363D"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <ComboBox x:Name="BsYearBox" Width="95" Height="28" SelectionChanged="BsYearMonth_SelectionChanged" Margin="0,0,8,0"/>
                                <ComboBox x:Name="BsMonthBox" Width="130" Height="28" SelectionChanged="BsYearMonth_SelectionChanged"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- DAYS OF WEEK HEADER -->
                        <UniformGrid Columns="7" Margin="0,6,0,6">
                            <TextBlock Text="आइत (Sun)" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11" Foreground="#F0883E"/>
                            <TextBlock Text="सोम (Mon)" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11" Foreground="#8B949E"/>
                            <TextBlock Text="मङ्गल (Tue)" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11" Foreground="#8B949E"/>
                            <TextBlock Text="बुध (Wed)" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11" Foreground="#8B949E"/>
                            <TextBlock Text="बिहि (Thu)" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11" Foreground="#8B949E"/>
                            <TextBlock Text="शुक्र (Fri)" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11" Foreground="#8B949E"/>
                            <TextBlock Text="शनि (Sat)" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11" Foreground="#FF7B72"/>
                        </UniformGrid>
                        <Separator Background="#21262D" Margin="0,0,0,6"/>

                        <!-- 7x6 CALENDAR GRID -->
                        <UniformGrid x:Name="CalendarDaysGrid" Columns="7" Rows="6" Height="190"/>
                    </StackPanel>
                </Border>

                <!-- CONVERTER SECTION -->
                <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- AD TO BS -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="CONVERT AD ➔ BS" FontWeight="Bold" Foreground="#7EE787" FontSize="12"/>
                            <TextBlock Text="Select Gregorian (AD) Date:" FontSize="11" Foreground="#8B949E" Margin="0,4,0,2"/>
                            <DatePicker x:Name="AdConvertPicker" SelectedDateChanged="AdConvertPicker_SelectedDateChanged" Margin="0,2,0,6"/>
                            <TextBlock Text="Resulting Bikram Sambat Date:" FontSize="11" Foreground="#8B949E"/>
                            <TextBox x:Name="AdToBsResultBox" IsReadOnly="True" FontWeight="Bold" Foreground="#58A6FF" Background="#0D1117" Margin="0,2,0,0" Padding="6"/>
                        </StackPanel>

                        <!-- BS TO AD -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="CONVERT BS ➔ AD" FontWeight="Bold" Foreground="#D2A8FF" FontSize="12"/>
                            <TextBlock Text="Enter BS Year, Month, Day:" FontSize="11" Foreground="#8B949E" Margin="0,4,0,2"/>
                            <Grid Margin="0,2,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ConvBsYearBox" Text="2081" Margin="0,0,4,0" ToolTip="BS Year (2000-2099)"/>
                                <TextBox x:Name="ConvBsMonthBox" Grid.Column="1" Text="6" Margin="2,0" ToolTip="BS Month (1-12)"/>
                                <TextBox x:Name="ConvBsDayBox" Grid.Column="2" Text="17" Margin="4,0,0,0" ToolTip="BS Day (1-32)"/>
                            </Grid>
                            <Button Content="CONVERT TO AD" Click="ConvertBsToAd_Click" Margin="0,0,0,6" Background="#21262D" BorderBrush="#30363D"/>
                            <TextBox x:Name="BsToAdResultBox" IsReadOnly="True" FontWeight="Bold" Foreground="#7EE787" Background="#0D1117" Margin="0,2,0,0" Padding="6"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- GLOBAL NRCS SETTINGS SECTION -->
                <Border Background="#1C2128" BorderBrush="#388BFD" BorderThickness="1" CornerRadius="6" Padding="14">
                    <StackPanel>
                        <TextBlock Text="⚙ NRCS DATE SYSTEM CONFIGURATION" FontWeight="Bold" Foreground="#79C0FF" FontSize="13"/>
                        <TextBlock Text="Define default calendar system for Story Bank, Rundown, Diary, and Prompter." FontSize="11" Foreground="#8B949E" Margin="0,2,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="DEFAULT DATE SYSTEM:" FontWeight="SemiBold" FontSize="11" Foreground="#C9D1D9"/>
                                <ComboBox x:Name="DateSystemBox" Height="28" Margin="0,4,0,8">
                                    <ComboBoxItem Content="BS (Bikram Sambat) - Default" Tag="BS" IsSelected="True"/>
                                    <ComboBoxItem Content="AD (Gregorian)" Tag="AD"/>
                                    <ComboBoxItem Content="DUAL (BS + AD Combined)" Tag="DUAL"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="NUMERAL SYSTEM:" FontWeight="SemiBold" FontSize="11" Foreground="#C9D1D9"/>
                                <ComboBox x:Name="NumeralSystemBox" Height="28" Margin="0,4,0,8">
                                    <ComboBoxItem Content="Nepali Devnagari (०, १, २, ३...)" Tag="Devanagari" IsSelected="True"/>
                                    <ComboBoxItem Content="Standard Digits (0, 1, 2, 3...)" Tag="Standard"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Button Content="SAVE &amp; APPLY AS NRCS DEFAULT" Click="SaveSettings_Click" Height="32" Background="#1F6FEB" Foreground="White" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- FOOTER ACTIONS -->
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="StatusLabel" Text="Calendar ready." Foreground="#8B949E" VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="USE SELECTED DATE" Click="ApplyDate_Click" Padding="12,5" Background="#238636" Foreground="White" FontWeight="Bold" Margin="0,0,8,0"/>
                <Button Content="CLOSE" Click="Close_Click" Padding="12,5" Background="#21262D" BorderBrush="#30363D"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
