<Window x:Class="Kashtrix.ApiGateway.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kashtrix Broadcast API Gateway &amp; Common Bus"
        Width="1320" Height="820" MinWidth="1080" MinHeight="680"
        Background="{StaticResource Bg0Brush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Closing="Window_Closing">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource PanelBorder}">
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Background" Value="{StaticResource Bg1Brush}"/>
            <Setter Property="BorderBrush" Value="#252D37"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Background" Value="{StaticResource Bg2Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2C3440"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A2028"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#3F245E"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="{StaticResource Bg0Brush}">
        <Grid>
            <Grid.RowDefinitions>
                <!-- 0: Sleek Custom TitleBar matching Playout & CG Controller -->
                <RowDefinition Height="50"/>
                <!-- 1: Protocol Metric Cards -->
                <RowDefinition Height="Auto"/>
                <!-- 2: Active Channels & Connected Clients / Endpoints -->
                <RowDefinition Height="*"/>
                <!-- 3: Splitter -->
                <RowDefinition Height="6"/>
                <!-- 4: Event Log & Telemetry Console -->
                <RowDefinition Height="210" MinHeight="130"/>
            </Grid.RowDefinitions>

            <!-- ROW 0: CUSTOM TITLEBAR (Drag, Brand, Status Pill, Quick Actions, Clock, Window Controls) -->
            <Border Grid.Row="0" Background="#0E1115" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Brand & Subtitle -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" Background="#5B21B6" CornerRadius="5" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="⚡" FontSize="16" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="KASHTRIX " FontSize="14.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="API GATEWAY" FontSize="14.5" FontWeight="Bold" Foreground="#C084FC"/>
                                <Border x:Name="StatusBadge" Background="#143322" BorderBrush="{StaticResource GoodBrush}" BorderThickness="1" CornerRadius="3" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource GoodBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="StatusBadgeText" Text="ONLINE · 127.0.0.1:9080" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource GoodBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="UNIFIED BROADCAST BUS · REST · REALTIME WEBSOCKET · TCP JSONL · MCP ENGINE" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Quick Action Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button x:Name="BtnStart" Content="START" Click="Start_Click" Style="{StaticResource PrimaryActionButton}"/>
                        <Button x:Name="BtnStop" Content="STOP" Click="Stop_Click" Style="{StaticResource ActionButton}"/>
                        <Border Width="1" Height="18" Background="{StaticResource LineBrush}" Margin="6,0"/>
                        <Button Content="WEB PLAYOUT" Click="OpenPlayoutWeb_Click" Style="{StaticResource ActionButton}" ToolTip="Open Playout Web Application (Port 5173)"/>
                        <Button Content="WEB CG" Click="OpenCgWeb_Click" Style="{StaticResource ActionButton}" ToolTip="Open CG Controller Web Application (Port 5174)"/>
                        <Button Content="WEB MCR" Click="OpenWeb_Click" Style="{StaticResource ActionButton}" ToolTip="Open Gateway Health Dashboard"/>
                    </StackPanel>

                    <!-- Clock & Window Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="ClockText" Style="{StaticResource DigitalClockText}" FontSize="18" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <Button Click="Minimize_Click" Style="{StaticResource WindowControlButton}" ToolTip="Minimize"><TextBlock Style="{StaticResource WindowMinimizeGlyph}"/></Button>
                        <Button Click="Maximize_Click" Style="{StaticResource WindowControlButton}" ToolTip="Maximize / Restore"><TextBlock Style="{StaticResource WindowMaximizeGlyph}"/></Button>
                        <Button Click="Close_Click" Style="{StaticResource WindowCloseButton}" ToolTip="Close"><TextBlock Style="{StaticResource WindowCloseGlyph}"/></Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ROW 1: PROTOCOL METRIC CARDS (4-Column) -->
            <Grid Grid.Row="1" Margin="12,10,12,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 1. REST / WebSocket -->
                <Border Grid.Column="0" Style="{StaticResource MetricCard}" Margin="0,0,5,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="REST &amp; WEBSOCKET" Style="{StaticResource SectionCaption}"/>
                            <TextBlock Text="HTTP" HorizontalAlignment="Right" FontSize="9" FontWeight="Bold" Foreground="{StaticResource GoodBrush}"/>
                        </Grid>
                        <TextBox x:Name="HttpText" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" FontFamily="Consolas" Margin="0,0,0,2"/>
                        <TextBlock Text="Playout, CG, MAM, NRCS, Prompter, HA" FontSize="9" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Text="CORS Enabled · Event Stream /api/v1/events/ws" FontSize="8.5" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 2. TCP JSONL -->
                <Border Grid.Column="1" Style="{StaticResource MetricCard}" Margin="3,0,3,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="TCP STREAMING BUS" Style="{StaticResource SectionCaption}"/>
                            <TextBlock Text="TCP" HorizontalAlignment="Right" FontSize="9" FontWeight="Bold" Foreground="#38BDF8"/>
                        </Grid>
                        <TextBox x:Name="TcpText" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" FontFamily="Consolas" Margin="0,0,0,2"/>
                        <TextBlock Text="Line-delimited JSON-RPC &amp; broadcast pub/sub" FontSize="9" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Text="Persistent sessions · Zero-latency command bus" FontSize="8.5" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 3. UDP -->
                <Border Grid.Column="2" Style="{StaticResource MetricCard}" Margin="3,0,3,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="UDP TELEMETRY BUS" Style="{StaticResource SectionCaption}"/>
                            <TextBlock Text="UDP" HorizontalAlignment="Right" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                        </Grid>
                        <TextBox x:Name="UdpText" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" FontFamily="Consolas" Margin="0,0,0,2"/>
                        <TextBlock Text="Non-blocking fire-and-forget packet dispatcher" FontSize="9" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Text="Hardware GPI, automation triggers &amp; heartbeats" FontSize="8.5" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 4. MCP Engine -->
                <Border Grid.Column="3" Style="{StaticResource MetricCard}" Margin="5,0,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="MODEL CONTEXT PROTOCOL" Style="{StaticResource SectionCaption}"/>
                            <TextBlock Text="MCP" HorizontalAlignment="Right" FontSize="9" FontWeight="Bold" Foreground="#C084FC"/>
                        </Grid>
                        <TextBox x:Name="McpText" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" FontFamily="Consolas" Margin="0,0,0,2"/>
                        <TextBlock Text="Autonomous AI agentic tool &amp; resource server" FontSize="9" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Text="JSON-RPC 2.0 · 17 Native Broadcast Tools Ready" FontSize="8.5" Foreground="#C084FC" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ROW 2: ACTIVE CHANNELS (Left) & CONNECTED CLIENTS / ENDPOINTS (Right) -->
            <Grid Grid.Row="2" Margin="12,6,12,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="6*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Channels detected on PlatformControlBus -->
                <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Margin="0,0,5,0" Padding="12">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="ACTIVE BROADCAST CHANNELS &amp; ENGINES" Style="{StaticResource SectionCaption}"/>
                            <Button Content="REFRESH" Click="RefreshChannels_Click" HorizontalAlignment="Right" Padding="8,2" FontSize="9.5" Background="#1E2631" BorderBrush="{StaticResource LineBrush}" Foreground="{StaticResource TextBrush}"/>
                        </Grid>
                        <ListBox x:Name="ChannelsList" Background="#0A0E13" BorderBrush="#252D37" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0E131A" BorderBrush="#1C2430" BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{StaticResource GoodBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ChannelName}" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                                                <TextBlock Text="{Binding ChannelId}" FontSize="9.5" Foreground="{StaticResource MutedBrush}" FontFamily="Consolas"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Engine}" FontSize="10" Foreground="#38BDF8" VerticalAlignment="Center" Margin="8,0" FontWeight="SemiBold"/>
                                            <Border Grid.Column="3" Background="#16261C" BorderBrush="{StaticResource GoodBrush}" BorderThickness="1" CornerRadius="2" Padding="6,1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding State}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource GoodBrush}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Right: Connected Clients & Protocol Sessions -->
                <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Margin="5,0,0,0" Padding="12">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="CONNECTED CLIENTS &amp; ACTIVE PROTOCOL SESSIONS" Style="{StaticResource SectionCaption}"/>
                                <TextBlock x:Name="ClientsCountText" Text=" (0 active)" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Content="REFRESH" Click="RefreshClients_Click" HorizontalAlignment="Right" Padding="8,2" FontSize="9.5" Background="#1E2631" BorderBrush="{StaticResource LineBrush}" Foreground="{StaticResource TextBrush}"/>
                        </Grid>
                        <ListBox x:Name="ClientsList" Background="#0A0E13" BorderBrush="#252D37" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0E131A" BorderBrush="#1C2430" BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Protocol Badge -->
                                            <Border Grid.Column="0" Background="#231938" BorderBrush="#7C3AED" BorderThickness="1" CornerRadius="2" Padding="5,1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Protocol}" FontSize="9" FontWeight="Bold" Foreground="#C084FC"/>
                                            </Border>

                                            <!-- Client Address -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ClientAddress}" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" FontFamily="Consolas"/>
                                                <TextBlock Text="{Binding UserAgent}" FontSize="8.5" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                                            </StackPanel>

                                            <!-- Last Path / Action -->
                                            <TextBlock Grid.Column="2" Text="{Binding LastPathOrAction}" FontSize="10" Foreground="#38BDF8" FontFamily="Consolas" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="6,0"/>

                                            <!-- Request Count Pill -->
                                            <Border Grid.Column="3" Background="#18202A" BorderBrush="#2B3A4C" BorderThickness="1" CornerRadius="2" Padding="5,1" VerticalAlignment="Center" Margin="4,0">
                                                <TextBlock Text="{Binding RequestCount, StringFormat='{}{0} reqs'}" FontSize="8.5" Foreground="#94A3B8"/>
                                            </Border>

                                            <!-- Status Pill -->
                                            <Border Grid.Column="4" Background="#16261C" BorderBrush="{StaticResource GoodBrush}" BorderThickness="1" CornerRadius="2" Padding="6,1" VerticalAlignment="Center" Margin="4,0">
                                                <TextBlock Text="{Binding Status}" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource GoodBrush}"/>
                                            </Border>

                                            <!-- Last Activity Time -->
                                            <TextBlock Grid.Column="5" Text="{Binding LastActivityUtc, StringFormat='HH:mm:ss'}" FontSize="9.5" Foreground="{StaticResource MutedBrush}" FontFamily="Consolas" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ROW 3: GridSplitter -->
            <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#18202A" ShowsPreview="True" Cursor="SizeNS"/>

            <!-- ROW 4: EVENT LOG & PROTOCOL TELEMETRY CONSOLE -->
            <Border Grid.Row="4" Style="{StaticResource PanelBorder}" Margin="12,0,12,12" Padding="12">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="GATEWAY EVENT LOG &amp; REALTIME TELEMETRY CONSOLE" Style="{StaticResource SectionCaption}"/>
                            <TextBlock x:Name="LogCountText" Text=" (0 events)" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <CheckBox x:Name="AutoScrollCheck" Content="AUTO-SCROLL" IsChecked="True" FontSize="10" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource MutedBrush}"/>
                            <Button Content="CLEAR LOG" Click="ClearLog_Click" Padding="8,2" FontSize="9.5" Background="#1E2631" BorderBrush="{StaticResource LineBrush}" Foreground="{StaticResource TextBrush}"/>
                        </StackPanel>
                    </Grid>
                    <TextBox x:Name="LogBox"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas, Cascadia Code, Courier New"
                             FontSize="10.5"
                             Background="#080B0F"
                             Foreground="#C9D3DD"
                             BorderBrush="#1F2630"
                             BorderThickness="1"
                             Padding="8"
                             TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
