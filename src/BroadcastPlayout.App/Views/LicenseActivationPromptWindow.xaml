<Window x:Class="BroadcastPlayout.Views.LicenseActivationPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kashtrix License Authority" Width="680" Height="470"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        Background="{StaticResource Bg0Brush}" Foreground="{StaticResource TextBrush}"
        Icon="pack://application:,,,/Kashtrix.Playout;component/Branding/kashtrix-playout.ico">
    <Border BorderBrush="#334155" BorderThickness="1.5" Background="#0C1017" CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="52"/>
            </Grid.RowDefinitions>

            <!-- TITLE BAR -->
            <Border Grid.Row="0" Background="#121824" BorderBrush="#1F2A3D" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="14,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Kashtrix.Playout;component/Branding/kashtrix-playout.png" Width="20" Height="20" Stretch="Uniform" Margin="0,0,8,0"/>
                        <TextBlock Text="KASHTRIX LICENSE AUTHORITY" FontWeight="Bold" FontSize="12.5" Foreground="#F0F6FC" VerticalAlignment="Center"/>
                        <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="10,0,0,0">
                            <TextBlock Text="ACTIVATION REQUIRED" FontSize="9" FontWeight="Bold" Foreground="#94A3B8"/>
                        </Border>
                    </StackPanel>
                    <Button Grid.Column="2" Click="Close_Click" Style="{StaticResource WindowCloseButton}"><TextBlock Style="{StaticResource WindowCloseGlyph}"/></Button>
                </Grid>
            </Border>

            <!-- MAIN BODY -->
            <Grid Grid.Row="1" Margin="20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- BANNER -->
                <Border Grid.Row="0" Background="#0F172A" BorderBrush="#334155" BorderThickness="1.5" CornerRadius="4" Padding="14,10" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔒" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock x:Name="AppTitleText" Text="Kashtrix Broadcast Application Is Unlicensed" FontWeight="Bold" FontSize="13" Foreground="#F0F6FC"/>
                            <TextBlock x:Name="ReasonMessageText" Text="This application cannot run without an active broadcast license. Provide your KTX token below to activate." Foreground="#CBD5E1" FontSize="10.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- KTX TOKEN BOX (REQUESTED BY USER) -->
                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="KTX DEVICE PROVISIONING TOKEN (REQUIRED FOR LICENSE ACTIVATION)" FontWeight="Bold" FontSize="10" Foreground="#38BDF8"/>
                        <TextBlock Grid.Column="1" Text="Omni License Protocol v2" FontSize="9" Foreground="{StaticResource MutedBrush}"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="KtxTokenBox" Text="KTX1..." IsReadOnly="True" Margin="0,0,8,0" Height="30" Background="#060A0F" Foreground="#38BDF8" FontFamily="Consolas" FontSize="10.5" Padding="8,5" BorderBrush="#1C2D42"/>
                        <Button Grid.Column="1" x:Name="CopyKtxButton" Content="📋 COPY KTX" Style="{StaticResource DemoActionButton}" Click="CopyKtx_Click" Height="30" Padding="14,2" MinWidth="105" ToolTip="Copy KTX code to register on License Server"/>
                    </Grid>
                </StackPanel>

                <!-- HARDWARE ID BOX -->
                <StackPanel Grid.Row="2" Margin="0,0,0,10">
                    <TextBlock Text="WORKSTATION HARDWARE ID (HWID)" Style="{StaticResource SectionCaption}" Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="HwidBox" Text="KTX-NODE-..." IsReadOnly="True" Margin="0,0,8,0" Height="28" Background="#060A0F" Foreground="#CBD5E1" FontFamily="Consolas" FontSize="10" Padding="8,4" BorderBrush="#1A2432"/>
                        <Button Grid.Column="1" Content="COPY HWID" Style="{StaticResource SmallTool}" Click="CopyHwid_Click" Height="28" Padding="12,2" MinWidth="105"/>
                    </Grid>
                </StackPanel>

                <!-- NOTICE & AUTO-RESOLVE STATUS -->
                <StackPanel Grid.Row="3" VerticalAlignment="Bottom">
                    <TextBlock x:Name="AutoResolveStatusText" Text="⚡ Auto-wait active: Connecting to license server for automated dispatch..." Foreground="#94A3B8" FontSize="10" Margin="0,0,0,4"/>
                    <TextBlock Text="To unlock this engine, copy your KTX token to activate via Kashtrix License Server, or click 'OPEN LICENSE MANAGER' to enter your license serial key." Foreground="{StaticResource MutedBrush}" FontSize="9.5" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <!-- FOOTER BAR -->
            <Border Grid.Row="2" Background="#0A0E15" BorderBrush="#18202C" BorderThickness="0,1,0,0" Padding="16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="FooterFeedbackText" Text="Click 'COPY KTX' to obtain your activation token." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" FontSize="10"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="⚡ OPEN LICENSE MANAGER" Style="{StaticResource DemoActionButton}" Click="OpenLicenseManager_Click" Margin="0,0,8,0" Height="30" Padding="14,2" ToolTip="Open the full Kashtrix License Manager to enter license key"/>
                        <Button Content="CLOSE" Style="{StaticResource SmallTool}" Click="Close_Click" Width="80" Height="30" Padding="12,2"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
