<Window x:Class="BroadcastPlayout.Views.AuthorizeWorkstationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Authorize Workstation Node" Width="540" Height="420"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        Background="{StaticResource Bg0Brush}" Foreground="{StaticResource TextBrush}"
        Icon="pack://application:,,,/Kashtrix.Playout;component/Branding/kashtrix-playout.ico">
    <Border BorderBrush="#25354A" BorderThickness="1.5" Background="#0C1017" CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <!-- TITLE BAR -->
            <Border Grid.Row="0" Background="#121824" BorderBrush="#1C2738" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="12,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Kashtrix.Playout;component/Branding/kashtrix-playout.png" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0"/>
                        <TextBlock Text="AUTHORIZE APPLICATION WORKSTATION NODE" FontWeight="Bold" FontSize="11.5" Foreground="#F0F6FC" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="2" Click="Cancel_Click" Style="{StaticResource WindowCloseButton}"><TextBlock Style="{StaticResource WindowCloseGlyph}"/></Button>
                </Grid>
            </Border>

            <!-- FORM BODY -->
            <StackPanel Grid.Row="1" Margin="20,16">
                <TextBlock Text="Register a newly installed application instance (e.g. Playout on another system) under the central license." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,14"/>

                <!-- APPLICATION TYPE -->
                <TextBlock Text="APPLICATION TYPE" Style="{StaticResource SectionCaption}" Margin="0,0,0,3"/>
                <ComboBox x:Name="AppTypeCombo" Height="28" Margin="0,0,0,10">
                    <ComboBoxItem Content="Kashtrix Playout (Playout.app)" IsSelected="True"/>
                    <ComboBoxItem Content="Kashtrix Output Engine"/>
                    <ComboBoxItem Content="Kashtrix Input Engine"/>
                    <ComboBoxItem Content="Kashtrix CG Controller"/>
                    <ComboBoxItem Content="Kashtrix CG Designer (CGEditor)"/>
                    <ComboBoxItem Content="Kashtrix Channel Controller"/>
                    <ComboBoxItem Content="Kashtrix High-Availability Redundancy (HA)"/>
                    <ComboBoxItem Content="Kashtrix NRCS Newsroom"/>
                    <ComboBoxItem Content="Kashtrix Ingest Server"/>
                    <ComboBoxItem Content="Kashtrix MAM Asset Manager"/>
                    <ComboBoxItem Content="Kashtrix Multiviewer Monitor"/>
                    <ComboBoxItem Content="Kashtrix Playlist Editor"/>
                    <ComboBoxItem Content="Kashtrix Broadcast Scheduler"/>
                    <ComboBoxItem Content="Kashtrix Studio Teleprompter"/>
                    <ComboBoxItem Content="Kashtrix QC Controller"/>
                    <ComboBoxItem Content="Kashtrix File Manager"/>
                </ComboBox>

                <!-- CHANNEL / NODE NAME -->
                <TextBlock Text="CHANNEL / NODE NAME" Style="{StaticResource SectionCaption}" Margin="0,0,0,3"/>
                <TextBox x:Name="ChannelNameBox" Text="Channel 2 Playout" Height="28" Margin="0,0,0,10"/>

                <!-- WORKSTATION IP / HOSTNAME -->
                <TextBlock Text="WORKSTATION IP ADDRESS OR HOSTNAME" Style="{StaticResource SectionCaption}" Margin="0,0,0,3"/>
                <TextBox x:Name="HostIpBox" Text="192.168.1.102" Height="28" Margin="0,0,0,10" FontFamily="Consolas"/>

                <!-- REMOTE HARDWARE ID (OPTIONAL) -->
                <TextBlock Text="REMOTE SYSTEM HARDWARE ID (OPTIONAL / AUTO)" Style="{StaticResource SectionCaption}" Margin="0,0,0,3"/>
                <TextBox x:Name="HwidBox" Text="" Height="28" Margin="0,0,0,12" FontFamily="Consolas"/>

                <!-- QUOTA METRIC -->
                <Border Background="#101824" BorderBrush="#1C2D44" BorderThickness="1" CornerRadius="4" Padding="10,6">
                    <TextBlock x:Name="QuotaSummaryText" Text="Playout License Quota: 1 / 16 Channels Authorized" Foreground="#38BDF8" FontSize="10" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>

            <!-- FOOTER -->
            <Border Grid.Row="2" Background="#0A0E15" BorderBrush="#18202C" BorderThickness="0,1,0,0" Padding="14,0">
                <Grid>
                    <TextBlock x:Name="ValidationStatusText" Text="" Foreground="#F87171" VerticalAlignment="Center" FontSize="10"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="⚡ AUTHORIZE NODE" Style="{StaticResource DemoActionButton}" Click="Authorize_Click" Margin="0,0,8,0" Height="28" Padding="14,2"/>
                        <Button Content="CANCEL" Style="{StaticResource SmallTool}" Click="Cancel_Click" Width="76" Height="28" Padding="12,2"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
