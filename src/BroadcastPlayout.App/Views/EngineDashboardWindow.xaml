<Window x:Class="BroadcastPlayout.Views.EngineDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kashtrix Broadcast Engines Dashboard" Width="1060" Height="700" MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource Bg0Brush}" Foreground="{StaticResource TextBrush}"
        Icon="pack://application:,,,/Kashtrix.Playout;component/Branding/kashtrix-playout.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1" Background="{StaticResource Bg0Brush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="44"/>
            </Grid.RowDefinitions>

            <!-- TITLEBAR -->
            <Border Grid.Row="0" Background="#0C1116" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="12,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Kashtrix.Playout;component/Branding/kashtrix-playout.png" Width="24" Height="24" Stretch="Uniform" Margin="0,0,8,0"/>
                        <TextBlock Text="KASHTRIX BROADCAST ENGINES DASHBOARD" FontWeight="Bold" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock Text="  ·  LIVE SUITE CONTROLLER &amp; TELEMETRY" Foreground="{StaticResource AccentBrush}" FontSize="9.5" VerticalAlignment="Center" Margin="6,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource WindowControlButton}" Click="Minimize_Click"><TextBlock Style="{StaticResource WindowMinimizeGlyph}"/></Button>
                        <Button Style="{StaticResource WindowControlButton}" Click="Maximize_Click"><TextBlock x:Name="MaxGlyph" Style="{StaticResource WindowMaximizeGlyph}"/></Button>
                        <Button Style="{StaticResource WindowCloseButton}" Click="Close_Click"><TextBlock Style="{StaticResource WindowCloseGlyph}"/></Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- TOP METRICS / GLOBAL ACTIONS TOOLBAR -->
            <Border Grid.Row="1" Background="#0E141C" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#142132" BorderBrush="#253D5C" BorderThickness="1" CornerRadius="3" Padding="10,4" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="ACTIVE ENGINES: " Foreground="{StaticResource MutedBrush}" FontSize="9.5" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ActiveEnginesCountText" Text="2 / 6 RUNNING" Foreground="#38BDF8" FontSize="10.5" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#16221D" BorderBrush="#274A3A" BorderThickness="1" CornerRadius="3" Padding="10,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="SYSTEM STATUS: " Foreground="{StaticResource MutedBrush}" FontSize="9.5" FontWeight="SemiBold"/>
                                <TextBlock Text="HEALTHY · BROADCAST READY" Foreground="#55C878" FontSize="10.5" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="▶ START ALL ENGINES" Style="{StaticResource DemoActionButton}" Click="StartAll_Click" Margin="0,0,8,0" Height="28"/>
                        <Button Content="■ STOP ALL ENGINES" Style="{StaticResource WindowControlButton}" Click="StopAll_Click" Margin="0,0,8,0" Height="28"/>
                        <Button Content="REFRESH" Style="{StaticResource WindowControlButton}" Click="Refresh_Click" Height="28"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ENGINES CARDS LISTVIEW -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="EnginesControl" Margin="14,10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,5" Background="#0B1015" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1.5" CornerRadius="4" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- ICON -->
                                    <Border Width="38" Height="38" Background="#121820" BorderBrush="#202A36" BorderThickness="1" CornerRadius="19" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding IconGlyph}" FontSize="18" Foreground="{Binding AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- NAME & APP -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,8,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12.5" Foreground="#F0F4F8"/>
                                        <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- DETAILS / METRICS -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="6,0,12,0">
                                        <TextBlock Text="{Binding Description}" FontSize="9.5" Foreground="#CBD5E1" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Telemetry}" FontSize="8.5" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- STATUS BADGE -->
                                    <Border Grid.Column="3" Background="{Binding StatusBg}" BorderBrush="{Binding StatusBorder}" BorderThickness="1" CornerRadius="3" Padding="8,4" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Fill="{Binding StatusDotBrush}" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding StatusText, Mode=OneWay}" Foreground="{Binding StatusFg}" FontWeight="Bold" FontSize="9"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- ACTION BUTTONS -->
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="START ENGINE" Click="CardStart_Click" Tag="{Binding}" Style="{StaticResource SmallTool}" Height="28" Margin="0,0,4,0" ToolTip="Run engine as a background service"/>
                                        <Button Content="OPEN UI" Click="CardOpenUi_Click" Tag="{Binding}" Style="{StaticResource SmallTool}" Height="28" Margin="0,0,4,0" ToolTip="Open the application GUI"/>
                                        <Button Content="STOP" Click="CardStop_Click" Tag="{Binding}" Style="{StaticResource WindowControlButton}" Height="28" ToolTip="Terminate running engine process"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- FOOTER -->
            <Border Grid.Row="3" Background="#0C1116" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="14,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="FooterStatusText" Text="Continuous background monitoring active · auto-refreshes every 2 seconds" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" FontSize="9.5"/>
                    <Button Grid.Column="1" Content="CLOSE" Width="80" Height="26" Click="Close_Click" Style="{StaticResource WindowControlButton}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
