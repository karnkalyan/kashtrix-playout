<Window x:Class="BroadcastPlayout.Views.KeyframeCurveEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keyframe Motion Speed Curves"
        Width="820" Height="560" MinWidth="680" MinHeight="440"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        ResizeMode="CanResizeWithGrip" Background="#0C1017" BorderBrush="#263445" BorderThickness="1">
    <Window.Resources>
        <DrawingBrush x:Key="MotionGridBrush" TileMode="Tile" Viewport="0,0,32,32" ViewportUnits="Absolute" Stretch="None">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#0E141D">
                        <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,32,32"/></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#1B2636" Thickness="1"/>
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <LineGeometry StartPoint="0,32" EndPoint="32,32"/>
                                <LineGeometry StartPoint="32,0" EndPoint="32,32"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#080C12" BorderBrush="#1C2733" BorderThickness="0,0,0,1" Padding="14,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="KEYFRAME MOTION SPEED CURVES" FontWeight="Bold" FontSize="13" Foreground="#ECEFF1" VerticalAlignment="Center"/>
                    <TextBlock Text="· BÉZIER TANGENT &amp; EASING" FontSize="11" Foreground="#00E5FF" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="KeyframeInfoText" Grid.Column="1" Text="Keyframe at 0.00s" Foreground="#7D8D9D" FontSize="11" TextAlignment="Right" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="✕" Click="Close_Click" Width="26" Height="24" Background="Transparent" Foreground="#ECEFF1" BorderThickness="0" FontSize="12" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Curve Canvas Area -->
        <Border Grid.Row="1" Background="{StaticResource MotionGridBrush}" Margin="8" BorderBrush="#1E2A38" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
            <Grid>
                <Canvas x:Name="CurveCanvas" Background="Transparent" SizeChanged="CurveCanvas_SizeChanged" MouseMove="CurveCanvas_MouseMove" MouseLeftButtonUp="CurveCanvas_MouseLeftButtonUp">
                    <!-- Dashed tangent lines -->
                    <Line x:Name="TangentLine1" Stroke="#EA6C5E" StrokeThickness="1.5" StrokeDashArray="3,3"/>
                    <Line x:Name="TangentLine2" Stroke="#EA6C5E" StrokeThickness="1.5" StrokeDashArray="3,3"/>

                    <!-- Smooth Bézier curve path -->
                    <Path Stroke="#EA6C5E" StrokeThickness="2.5">
                        <Path.Data>
                            <PathGeometry>
                                <PathFigure x:Name="CurveFigure" StartPoint="50,400">
                                    <BezierSegment x:Name="CurveBezier" Point1="150,300" Point2="350,150" Point3="500,100"/>
                                </PathFigure>
                            </PathGeometry>
                        </Path.Data>
                    </Path>

                    <!-- Keyframe Points (White Squares) -->
                    <Rectangle x:Name="Point0" Width="14" Height="14" Fill="#FFFFFF" RadiusX="2" RadiusY="2" Cursor="Hand" MouseLeftButtonDown="Point0_MouseDown"/>
                    <Rectangle x:Name="Point1" Width="14" Height="14" Fill="#FFFFFF" RadiusX="2" RadiusY="2" Cursor="Hand" MouseLeftButtonDown="Point1_MouseDown"/>

                    <!-- Tangent Handles (Blue Rings with dark center) -->
                    <Ellipse x:Name="Handle1" Width="16" Height="16" Fill="#0E141D" Stroke="#4D7CFE" StrokeThickness="2.5" Cursor="Hand" MouseLeftButtonDown="Handle1_MouseDown"/>
                    <Ellipse x:Name="Handle2" Width="16" Height="16" Fill="#0E141D" Stroke="#4D7CFE" StrokeThickness="2.5" Cursor="Hand" MouseLeftButtonDown="Handle2_MouseDown"/>
                </Canvas>

                <!-- Floating Offset Widget (matching user reference image) -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24" Background="#161B26" BorderBrush="#253244" BorderThickness="1" CornerRadius="8" Padding="14,10" Effect="{x:Null}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Offset" Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="&lt;" Click="OffsetDec_Click" Width="32" Height="30" Background="#202A3B" BorderBrush="#33435C" Foreground="#ECEFF1" FontWeight="Bold" FontSize="13" Cursor="Hand"/>
                            <TextBox x:Name="OffsetTextBox" Text="10" Width="52" Height="30" Margin="4,0" Background="#0F141D" BorderBrush="#263447" Foreground="#00E5FF" FontWeight="Bold" FontSize="13" TextAlignment="Center" VerticalContentAlignment="Center" LostFocus="OffsetTextBox_LostFocus"/>
                            <Button Content="&gt;" Click="OffsetInc_Click" Width="32" Height="30" Background="#202A3B" BorderBrush="#33435C" Foreground="#ECEFF1" FontWeight="Bold" FontSize="13" Cursor="Hand"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Top Presets Bar -->
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,12" Orientation="Horizontal">
                    <TextBlock Text="PRESETS:" Foreground="#788698" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Content="LINEAR" Click="PresetLinear_Click" Height="24" Padding="7,2" Margin="2,0" Background="#1A2433" BorderBrush="#28384E" Foreground="#E2E8F0" FontSize="10"/>
                    <Button Content="EASE IN" Click="PresetEaseIn_Click" Height="24" Padding="7,2" Margin="2,0" Background="#1A2433" BorderBrush="#28384E" Foreground="#E2E8F0" FontSize="10"/>
                    <Button Content="EASE OUT" Click="PresetEaseOut_Click" Height="24" Padding="7,2" Margin="2,0" Background="#1A2433" BorderBrush="#28384E" Foreground="#E2E8F0" FontSize="10"/>
                    <Button Content="EASE IN-OUT" Click="PresetEaseInOut_Click" Height="24" Padding="7,2" Margin="2,0" Background="#1A2433" BorderBrush="#28384E" Foreground="#E2E8F0" FontSize="10"/>
                    <Button Content="SMOOTH ACCEL" Click="PresetSmooth_Click" Height="24" Padding="7,2" Margin="2,0" Background="#1A2433" BorderBrush="#28384E" Foreground="#E2E8F0" FontSize="10"/>
                    <Button Content="BOUNCE" Click="PresetBounce_Click" Height="24" Padding="7,2" Margin="2,0" Background="#1A2433" BorderBrush="#28384E" Foreground="#E2E8F0" FontSize="10"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer / Apply -->
        <Border Grid.Row="2" Background="#080C12" BorderBrush="#1C2733" BorderThickness="0,1,0,0" Padding="14,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="CURVE EXPRESSION: " Foreground="#788698" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CurveExpressionText" Text="cubic-bezier(0.25, 0.10, 0.25, 1.00)" Foreground="#00E5FF" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="RESET DEFAULT" Click="Reset_Click" Height="28" Padding="10,0" Margin="0,0,8,0" Background="#1C2636" BorderBrush="#2C3D55" Foreground="#CBD5E1" FontSize="11"/>
                    <Button Content="APPLY TO KEYFRAME" Click="Apply_Click" Height="28" Padding="14,0" Background="#1E3A5F" BorderBrush="#3B82F6" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
