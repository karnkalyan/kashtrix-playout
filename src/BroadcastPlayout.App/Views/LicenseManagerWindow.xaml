<Window x:Class="BroadcastPlayout.Views.LicenseManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kashtrix License Manager" Width="920" Height="620" MinWidth="800" MinHeight="520"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource Bg0Brush}" Foreground="{StaticResource TextBrush}"
        Icon="pack://application:,,,/Kashtrix.Playout;component/Branding/kashtrix-playout.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1" Background="{StaticResource Bg0Brush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="48"/>
            </Grid.RowDefinitions>

            <!-- CUSTOM TITLEBAR -->
            <Border Grid.Row="0" Background="#0C1116" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="12,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Kashtrix.Playout;component/Branding/kashtrix-playout.png" Width="22" Height="22" Stretch="Uniform" Margin="0,0,8,0"/>
                        <TextBlock Text="KASHTRIX BROADCAST LICENSE MANAGER" FontWeight="Bold" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource WindowControlButton}" Click="Minimize_Click"><TextBlock Style="{StaticResource WindowMinimizeGlyph}"/></Button>
                        <Button Style="{StaticResource WindowControlButton}" Click="Maximize_Click"><TextBlock x:Name="MaxGlyph" Style="{StaticResource WindowMaximizeGlyph}"/></Button>
                        <Button Style="{StaticResource WindowCloseButton}" Click="Close_Click"><TextBlock Style="{StaticResource WindowCloseGlyph}"/></Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CONTENT BODY -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="18,14">
                    <!-- LICENSE STATUS BANNER -->
                    <Border Background="#101824" BorderBrush="#2A3D54" BorderThickness="1" CornerRadius="4" Padding="16,14" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="48" Height="48" Background="#1D2A3A" BorderBrush="#38BDF8" BorderThickness="1.5" CornerRadius="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🛡" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                <TextBlock Text="ENTERPRISE BROADCAST MASTER · PERPETUAL" FontWeight="Bold" FontSize="15" Foreground="#F0F6FC"/>
                                <TextBlock Text="Active broadcast license verified · Unlimited transmission channels &amp; full 4K UHD capability" Foreground="{StaticResource MutedBrush}" FontSize="10.5" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="2" Background="#173122" BorderBrush="#55C878" BorderThickness="1.5" CornerRadius="4" Padding="12,6" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="#55C878" Margin="0,0,6,0"/>
                                    <TextBlock Text="VALID &amp; ACTIVE" FontWeight="Bold" FontSize="11" Foreground="#85DE80"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- DETAILS GRID -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT DETAILS -->
                        <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Padding="14">
                            <StackPanel>
                                <TextBlock Text="LICENSE DETAILS" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,10"/>

                                <TextBlock Text="WORKSTATION NODE ID" Style="{StaticResource SectionCaption}"/>
                                <TextBox x:Name="NodeIdBox" Text="KTX-NODE-88F4-992C-4KPRO" IsReadOnly="True" Margin="0,3,0,10" Background="#070A0E"/>

                                <TextBlock Text="PRODUCT SERIAL / LICENSE KEY" Style="{StaticResource SectionCaption}"/>
                                <TextBox x:Name="LicenseKeyBox" Text="KTX-ENT-2026-9482-991A-F49H-PRO" Margin="0,3,0,10"/>

                                <TextBlock Text="REGISTERED ORGANIZATION" Style="{StaticResource SectionCaption}"/>
                                <TextBox x:Name="OrgBox" Text="Kashtrix Broadcast Systems Ltd." Margin="0,3,0,10"/>

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="EXPIRATION" Style="{StaticResource SectionCaption}"/>
                                        <TextBlock Text="Never (Permanent)" FontWeight="SemiBold" Foreground="#85DE80" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="CHANNEL QUOTA" Style="{StaticResource SectionCaption}"/>
                                        <TextBlock Text="16 Channels (Unlimited)" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- RIGHT FEATURE ENTITLEMENTS -->
                        <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="14">
                            <StackPanel>
                                <TextBlock Text="ACTIVATED MODULES &amp; CAPABILITIES" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,10"/>

                                <ItemsControl x:Name="FeaturesList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,3" Padding="6,4" Background="#0A0E13" BorderBrush="#1C242E" BorderThickness="1" CornerRadius="3">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="✓" Foreground="#55C878" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="10" Foreground="#E2E7EC" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="2" Background="#162A1E" Padding="6,2" CornerRadius="2">
                                                        <TextBlock Text="UNLOCKED" FontSize="8.5" FontWeight="Bold" Foreground="#85DE80"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ACTION BUTTONS -->
                    <Border Style="{StaticResource PanelBorder}" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="StatusMessageText" Text="Mock license status: all broadcast engines active and unlocked." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" FontSize="10.5"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="UPDATE KEY" Style="{StaticResource DemoActionButton}" Click="UpdateKey_Click" Margin="0,0,6,0"/>
                                <Button Content="EXPORT CERTIFICATE" Style="{StaticResource WindowControlButton}" Click="ExportCertificate_Click" Margin="0,0,6,0"/>
                                <Button Content="REFRESH" Style="{StaticResource WindowControlButton}" Click="Refresh_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- FOOTER -->
            <Border Grid.Row="2" Background="#0C1116" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="14,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Kashtrix Broadcast Systems · License Engine v4.9 · Offline Dongle-Free Licensing" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" FontSize="10"/>
                    <Button Grid.Column="1" Content="CLOSE" Width="80" Height="28" Click="Close_Click" Style="{StaticResource WindowControlButton}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
