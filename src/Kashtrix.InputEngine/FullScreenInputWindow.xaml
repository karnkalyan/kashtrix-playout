<Window x:Class="Kashtrix.InputEngine.FullScreenInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Full Screen Preview"
        WindowStyle="None" WindowState="Maximized" Topmost="True"
        Background="#03070D" Foreground="#E2E8F0"
        KeyDown="Window_KeyDown" MouseDoubleClick="Window_MouseDoubleClick">
    <Grid>
        <!-- LIVE VIDEO IMAGE -->
        <Image Source="{Binding PreviewImage}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- PLACEHOLDER WHEN AWAITING SIGNAL -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding PlaceholderVisibility}">
            <TextBlock Text="{Binding IconGlyph}" FontSize="64" Foreground="#475569" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,16,0,4"/>
            <TextBlock Text="Awaiting video signal..." FontSize="13" Foreground="#64748B" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- TOP OVERLAY BAR -->
        <Border VerticalAlignment="Top" Background="#E00A0F17" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding IconGlyph}" FontSize="18" Foreground="#00E5FF" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Border Background="{Binding StatusBg}" CornerRadius="3" Padding="8,2" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="{Binding StatusText, Mode=OneWay}" FontSize="9.5" FontWeight="Bold" Foreground="{Binding StatusFg}"/>
                    </Border>
                    <Border Background="#1E293B" CornerRadius="3" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FormatLabel}" FontSize="9.5" FontWeight="SemiBold" Foreground="#38BDF8"/>
                    </Border>
                </StackPanel>

                <Button Grid.Column="2" Content="✕ EXIT FULLSCREEN (ESC)" Click="Exit_Click" Height="28" Padding="14,0" Background="#1E293B" BorderBrush="#334155" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="11" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- BOTTOM HUD: AUDIO METERS & RESOLUTION -->
        <Border VerticalAlignment="Bottom" Background="#E6080D14" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- DUAL CHANNEL STEREO VU METERS -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="54"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="CH1" FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                    <ProgressBar Grid.Row="0" Grid.Column="1" Height="8" Value="{Binding AudioLevelL, Mode=OneWay}" Minimum="0" Maximum="100" Margin="0,3,10,3" Foreground="{Binding MeterBrushL}" Background="#1E293B" BorderThickness="0"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding AudioDbL}" FontSize="9.5" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="CH2" FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                    <ProgressBar Grid.Row="1" Grid.Column="1" Height="8" Value="{Binding AudioLevelR, Mode=OneWay}" Minimum="0" Maximum="100" Margin="0,3,10,3" Foreground="{Binding MeterBrushR}" Background="#1E293B" BorderThickness="0"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding AudioDbR}" FontSize="9.5" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>

                <!-- SOURCE RESOLUTION & STATUS -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding ResolutionInfo}" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding SourceDetails}" FontSize="9.5" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- ROUTING INFO -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1E293B" CornerRadius="3" Padding="10,4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding RouteStatusText}" FontSize="10" FontWeight="Bold" Foreground="{Binding RouteStatusColor}"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
