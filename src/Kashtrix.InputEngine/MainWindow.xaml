<Window x:Class="Kashtrix.InputEngine.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kashtrix Input Engine"
        Width="1280" Height="800" MinWidth="1020" MinHeight="620"
        Background="{StaticResource Bg0Brush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Closing="Window_Closing">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource PanelBorder}">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="{StaticResource Bg1Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        </Style>
        <Style x:Key="EngineButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="{StaticResource Bg2Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="RouteButton" TargetType="Button" BasedOn="{StaticResource EngineButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="{StaticResource Bg0Brush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="32"/>
            </Grid.RowDefinitions>

            <!-- TITLE BAR -->
            <Border Grid.Row="0" Background="#0C1015" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" Background="{StaticResource Bg2Brush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="4" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="🎛" FontSize="16" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="KASHTRIX " FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="INPUT ENGINE" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                <Border Background="#12251A" BorderBrush="{StaticResource GoodBrush}" BorderThickness="1" CornerRadius="3" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="StatusBadgeText" Text="LIVE INGEST &amp; ROUTING" FontSize="9" FontWeight="Bold" Foreground="{StaticResource GoodBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="MULTI-SOURCE LIVE INPUT GRID · REAL-TIME VU METERS · ROUTE TO PLAYOUT" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="＋ KASHTRIX STUDIO" Style="{StaticResource RouteButton}" Background="#4A156B" BorderBrush="{StaticResource AccentBrush}" Click="AddStudioSource_Click" ToolTip="Directly connect Kashtrix Studio live program feed via zero-copy shared memory"/>
                        <Button Content="+ ADD NEW SOURCE" Style="{StaticResource RouteButton}" Click="AddSource_Click"/>
                        <Button Content="ROUTE SELECTED TO PLAYOUT" Style="{StaticResource EngineButton}" Click="RouteToPlayout_Click"/>
                        <Button Click="Minimize_Click" Style="{StaticResource WindowControlButton}"><TextBlock Style="{StaticResource WindowMinimizeGlyph}"/></Button>
                        <Button Click="Maximize_Click" Style="{StaticResource WindowControlButton}"><TextBlock Style="{StaticResource WindowMaximizeGlyph}"/></Button>
                        <Button Click="Close_Click" Style="{StaticResource WindowCloseButton}"><TextBlock Style="{StaticResource WindowCloseGlyph}"/></Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- TOOLBAR / METRICS -->
            <Border Grid.Row="1" Background="{StaticResource Bg1Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="14,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="INGEST CHANNELS" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Border Background="{StaticResource Bg2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="3" Padding="8,2">
                            <TextBlock x:Name="InputCountText" Text="0 SOURCES CONFIGURED" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="ROUTING DESTINATION:" FontSize="9.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Border Background="{StaticResource Bg2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="3" Padding="8,2">
                            <TextBlock Text="KASHTRIX PLAYOUT · BROADCAST BUS" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- INPUT GRID / EMPTY STATE -->
            <Grid Grid.Row="2" Background="{StaticResource Bg0Brush}">
                <!-- Empty state when 0 inputs -->
                <StackPanel x:Name="EmptyStatePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <Border Width="64" Height="64" Background="{StaticResource Bg2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="32" HorizontalAlignment="Center" Margin="0,0,0,14">
                        <TextBlock Text="🎛" FontSize="26" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="NO INPUT SOURCES CONFIGURED" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="Click '+ ADD NEW SOURCE' to add RTSP, RTMP, NDI, DeckLink SDI, Screen capture or Video files." FontSize="10.5" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <Button Content="+ ADD NEW SOURCE" Style="{StaticResource RouteButton}" HorizontalAlignment="Center" Height="32" Padding="20,0" Click="AddSource_Click"/>
                </StackPanel>

                <!-- Cards Grid -->
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Background="{StaticResource Bg0Brush}">
                    <ItemsControl x:Name="InputSourcesGrid" Margin="12">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Stretch"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="386" Height="336" Margin="8" Background="{StaticResource Bg1Brush}" BorderBrush="{Binding BorderBrush}" BorderThickness="1.5" CornerRadius="4" Padding="10" MouseLeftButtonDown="InputCard_MouseLeftButtonDown">
                                    <Border.ContextMenu>
                                        <ContextMenu Background="#0E1724" BorderBrush="#2A384C" Foreground="#E2E8F0">
                                            <MenuItem Header="⛶  FULL SCREEN PREVIEW" Click="CardFullScreen_Click" Tag="{Binding}" FontWeight="Bold" Foreground="#00E5FF"/>
                                            <Separator Background="#223044"/>
                                            <MenuItem Header="{Binding PushButtonText}" Click="PushCardSource_Click" Tag="{Binding}" FontWeight="SemiBold"/>
                                            <MenuItem Header="{Binding MuteLabel}" Click="CardMute_Click" Tag="{Binding}"/>
                                            <Separator Background="#223044"/>
                                            <MenuItem Header="⚙  EDIT SOURCE SETTINGS" Click="CardEdit_Click" Tag="{Binding}"/>
                                            <MenuItem Header="✕  REMOVE SOURCE" Click="DeleteCard_Click" Tag="{Binding}" Foreground="#F87171"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- CARD HEADER -->
                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding SourceDetails}" FontSize="9" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="{Binding MuteLabel}" Click="CardMute_Click" Tag="{Binding}" Style="{StaticResource EngineButton}" Height="22" Padding="6,0" Margin="4,0" FontSize="8.5" ToolTip="Mute / unmute this input's audio monitor"/>
                                            <Border Grid.Column="2" Background="{Binding StatusBg}" CornerRadius="3" Padding="8,2" VerticalAlignment="Center" Margin="2,0">
                                                <TextBlock Text="{Binding StatusText, Mode=OneWay}" FontSize="8.5" FontWeight="Bold" Foreground="{Binding StatusFg}"/>
                                            </Border>
                                            <Button Grid.Column="3" Content="✕" Width="22" Height="22" Padding="0" Margin="4,0,0,0" Style="{StaticResource WindowCloseButton}" Click="DeleteCard_Click" Tag="{Binding}" ToolTip="Remove input source"/>
                                        </Grid>

                                        <!-- PREVIEW MONITOR / LIVE VIDEO SURFACE (16:9 ASPECT RATIO) -->
                                        <Border Grid.Row="1" Height="205" Background="#040608" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="3" ClipToBounds="True">
                                            <Grid>
                                                <!-- Real Decoded Video Image -->
                                                <Image Source="{Binding PreviewImage}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                <!-- Placeholder when stopped or awaiting signal -->
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding PlaceholderVisibility}">
                                                    <TextBlock Text="{Binding IconGlyph}" FontSize="28" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding FormatLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                                </StackPanel>

                                                <!-- Resolution / Signal Overlay Banner -->
                                                <Border Background="#CC090C10" VerticalAlignment="Bottom" Padding="8,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding ResolutionInfo}" FontSize="8.5" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding FormatLabel}" FontSize="8.5" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" Margin="6,0,0,0"/>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- DUAL-CHANNEL AUDIO VU LEVEL METERS -->
                                        <Grid Grid.Row="2" Margin="0,8,0,6">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="48"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="L" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                            <ProgressBar Grid.Row="0" Grid.Column="1" Height="6" Value="{Binding AudioLevelL, Mode=OneWay}" Minimum="0" Maximum="100" Margin="0,2,8,2" Foreground="{Binding MeterBrushL}" Background="{StaticResource Bg2Brush}" BorderThickness="0"/>
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding AudioDbL}" FontSize="8.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="R" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                            <ProgressBar Grid.Row="1" Grid.Column="1" Height="6" Value="{Binding AudioLevelR, Mode=OneWay}" Minimum="0" Maximum="100" Margin="0,2,8,2" Foreground="{Binding MeterBrushR}" Background="{StaticResource Bg2Brush}" BorderThickness="0"/>
                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding AudioDbR}" FontSize="8.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </Grid>

                                        <!-- CARD TRANSPORT & ROUTING ACTIONS -->
                                        <Grid Grid.Row="3" Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Specific per-input Play, Pause, Stop buttons -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="▶ PLAY" Click="CardPlay_Click" Tag="{Binding}" Style="{StaticResource EngineButton}" Height="26" Padding="8,0" Margin="0,0,4,0" FontSize="9" ToolTip="Start/Play this specific input"/>
                                                <Button Content="⏸ PAUSE" Click="CardPause_Click" Tag="{Binding}" Style="{StaticResource EngineButton}" Height="26" Padding="8,0" Margin="0,0,4,0" FontSize="9" ToolTip="Pause this specific input"/>
                                                <Button Content="⏹ STOP" Click="CardStop_Click" Tag="{Binding}" Style="{StaticResource EngineButton}" Height="26" Padding="8,0" FontSize="9" ToolTip="Stop this specific input"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1" Text="{Binding RouteStatusText}" FontSize="8.5" FontWeight="SemiBold" Foreground="{Binding RouteStatusColor}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,0" TextTrimming="CharacterEllipsis"/>
                                            <Button Grid.Column="2" Content="{Binding PushButtonText}" Background="{Binding PushButtonBg}" Style="{StaticResource RouteButton}" Height="26" FontSize="9" Click="PushCardSource_Click" Tag="{Binding}"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- FOOTER STATUS -->
            <Border Grid.Row="3" Background="#0C1015" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LastActionText" Text="Kashtrix Input Engine ready. Ingest and route live feeds." FontSize="9.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="KASHTRIX INPUT ENGINE · BROADCAST ROUTING" FontSize="9" Foreground="#64748B" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
