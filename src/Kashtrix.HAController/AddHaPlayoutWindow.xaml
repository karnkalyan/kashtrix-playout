<Window x:Class="Kashtrix.HAController.AddHaPlayoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add HA Playout Node" Width="520" Height="490"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="None"
        Background="{StaticResource Bg0Brush}" Foreground="{StaticResource TextBrush}">
    <Border BorderBrush="#3B2654" BorderThickness="1" Background="{StaticResource Bg0Brush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0" Background="#160C22" Height="34" MouseLeftButtonDown="Header_MouseDown">
                <DockPanel LastChildFill="True" Margin="12,0,8,0">
                    <Button DockPanel.Dock="Right" Content="✕" Width="28" Height="24" Background="Transparent" Foreground="#C5D1DE" BorderThickness="0" FontSize="12" Click="Close_Click" ToolTip="Close"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🛡" Foreground="#E6C4FF" FontSize="13" Margin="0,0,8,0"/>
                        <TextBlock Text="ADD HA PLAYOUT NODE" FontWeight="Bold" FontSize="11" Foreground="#E6C4FF" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Header Description -->
            <StackPanel Grid.Row="1" Margin="20,12,20,10">
                <TextBlock Text="Register a primary, hot standby, or shared pool playout instance for redundancy clustering." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Form -->
            <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Padding="16" Margin="20,0,20,0" Background="{StaticResource Bg1Brush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Channel ID -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="CHANNEL ID" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11"/>
                    <ComboBox x:Name="ChannelCombo" Grid.Row="0" Grid.Column="1" IsEditable="True" Margin="0,0,0,10" Height="28"/>

                    <!-- Node ID -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="NODE ID" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11"/>
                    <TextBox x:Name="NodeIdBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" Height="28"/>

                    <!-- Configured Mode -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="CONFIGURED MODE" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11"/>
                    <ComboBox x:Name="ModeCombo" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" Height="28">
                        <ComboBoxItem Content="PRIMARY" IsSelected="True"/>
                        <ComboBoxItem Content="BACKUP"/>
                        <ComboBoxItem Content="POOL"/>
                        <ComboBoxItem Content="STANDALONE"/>
                    </ComboBox>

                    <!-- Priority & Capacity -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="PRIORITY / CAPACITY" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11"/>
                    <Grid Grid.Row="3" Grid.Column="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PriorityBox" Grid.Column="0" Text="100" Height="28" ToolTip="Priority (1-100)"/>
                        <TextBox x:Name="CapacityBox" Grid.Column="2" Text="1" Height="28" ToolTip="Capacity (for Pool)"/>
                    </Grid>

                    <!-- Host / IP -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="HOST / IP ADDRESS" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11"/>
                    <TextBox x:Name="HostBox" Grid.Row="4" Grid.Column="1" Text="127.0.0.1" Margin="0,0,0,10" Height="28"/>

                    <!-- Output Armed & Playing Item -->
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="OUTPUT &amp; MEDIA" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11"/>
                    <Grid Grid.Row="5" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="ArmedCheck" Content="ARMED" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBox x:Name="MediaBox" Grid.Column="1" Text="Live-Playout-Feed.mp4" Height="28" ToolTip="Initial media clip"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,16,20,16">
                <Button Content="CANCEL" IsCancel="True" Width="90" Height="30" Margin="0,0,10,0"/>
                <Button Content="＋ ADD HA PLAYOUT" IsDefault="True" Width="150" Height="30" FontWeight="Bold" Background="#6B34A6" Foreground="White" Click="AddNode_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
