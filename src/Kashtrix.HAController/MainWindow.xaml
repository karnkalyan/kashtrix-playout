<Window x:Class="Kashtrix.HAController.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kashtrix Redundancy / HA Controller"
        Width="1540" Height="860" MinWidth="1100" MinHeight="650"
        Background="{StaticResource Bg0Brush}" WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER PANEL -->
        <Border Style="{StaticResource PanelBorder}" Padding="16,12" Background="{StaticResource Bg1Brush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="KASHTRIX REDUNDANCY / HA CONTROLLER" FontSize="21" FontWeight="Bold" Foreground="#E6C4FF"/>
                        <Border Background="#2B1647" BorderBrush="#7C3AED" BorderThickness="1" CornerRadius="4" Padding="7,2" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ClusterModeBadge" Text="BROADCAST CLUSTER" Foreground="#D8B4FE" FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="1+1 hot standby · N+M shared backup coordinator · output interlock · real-time heartbeat telemetry" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Top Right Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="CoordinatorCheck" Content="AUTO N+M COORDINATOR" IsChecked="True" VerticalAlignment="Center" Click="CoordinatorCheck_Click" FontWeight="SemiBold"/>
                    <Button Content="＋ ADD HA PLAYOUT" Background="#6B34A6" Foreground="White" FontWeight="Bold" Padding="12,6" Margin="14,0,0,0" Click="AddPlayout_Click"/>
                    <Button x:Name="DemoClusterButton" Content="LOAD DEMO CLUSTER" Background="#1E293B" Foreground="#38BDF8" FontWeight="SemiBold" Padding="12,6" Margin="8,0,0,0" Click="ToggleDemoCluster_Click"/>
                    <Button Content="↻ REFRESH" Padding="10,6" Margin="8,0,0,0" Click="Refresh_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN DATA GRID -->
        <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Padding="8" Margin="0,12" Background="{StaticResource Bg1Brush}">
            <DataGrid x:Name="NodeGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      Background="{StaticResource Bg1Brush}" BorderThickness="0" RowHeight="34" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#1E252D">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="CHANNEL" Binding="{Binding ChannelId}" Width="160" FontWeight="Bold"/>
                    <DataGridTextColumn Header="NODE" Binding="{Binding NodeId}" Width="200" FontFamily="Consolas"/>
                    <DataGridTextColumn Header="MODE" Binding="{Binding ConfiguredMode}" Width="110"/>

                    <!-- ROLE BADGE -->
                    <DataGridTemplateColumn Header="ROLE" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RuntimeRole}" Value="ACTIVE">
                                                    <Setter Property="Background" Value="#103823"/>
                                                    <Setter Property="BorderBrush" Value="#22C55E"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RuntimeRole}" Value="STANDBY">
                                                    <Setter Property="Background" Value="#382E0D"/>
                                                    <Setter Property="BorderBrush" Value="#EAB308"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RuntimeRole}" Value="BACKUP">
                                                    <Setter Property="Background" Value="#0F3042"/>
                                                    <Setter Property="BorderBrush" Value="#06B6D4"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RuntimeRole}" Value="FAILED">
                                                    <Setter Property="Background" Value="#451214"/>
                                                    <Setter Property="BorderBrush" Value="#EF4444"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding RuntimeRole}" FontWeight="Bold" FontSize="10.5">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RuntimeRole}" Value="ACTIVE">
                                                        <Setter Property="Foreground" Value="#4ADE80"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RuntimeRole}" Value="STANDBY">
                                                        <Setter Property="Foreground" Value="#FACC15"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RuntimeRole}" Value="BACKUP">
                                                        <Setter Property="Foreground" Value="#22D3EE"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RuntimeRole}" Value="FAILED">
                                                        <Setter Property="Foreground" Value="#F87171"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="PRIORITY" Binding="{Binding Priority}" Width="90"/>
                    <DataGridTextColumn Header="CAPACITY" Binding="{Binding Capacity}" Width="90"/>

                    <!-- OUTPUT ARMED BADGE -->
                    <DataGridTemplateColumn Header="OUTPUT" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding OutputArmed}" Value="True">
                                                    <Setter Property="Background" Value="#0F3820"/>
                                                    <Setter Property="BorderBrush" Value="#16A34A"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding OutputArmed}" Value="False">
                                                    <Setter Property="Background" Value="#24282F"/>
                                                    <Setter Property="BorderBrush" Value="#4B5563"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontWeight="Bold" FontSize="10">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding OutputArmed}" Value="True">
                                                        <Setter Property="Text" Value="ARMED (ON AIR)"/>
                                                        <Setter Property="Foreground" Value="#4ADE80"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding OutputArmed}" Value="False">
                                                        <Setter Property="Text" Value="INHIBITED"/>
                                                        <Setter Property="Foreground" Value="#9CA3AF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="PLAYING ITEM" Binding="{Binding CurrentItemId}" Width="*"/>
                    <DataGridTextColumn Header="POSITION" Binding="{Binding PositionSeconds, StringFormat={}{0:F1}s}" Width="100" FontFamily="Consolas"/>
                    <DataGridTextColumn Header="LAST SEEN" Binding="{Binding SeenUtc, StringFormat=HH:mm:ss.fff}" Width="130" FontFamily="Consolas"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- FOOTER ACTION BAR -->
        <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Padding="14,10" Background="{StaticResource Bg1Brush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText" Text="Listening for HA heartbeats..." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" FontSize="11.5"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="FORCE SELECTED ACTIVE" FontWeight="SemiBold" Click="ForceActive_Click"/>
                    <Button Content="⚡ SIMULATE FAILOVER" Background="#7F1D1D" Foreground="#FCA5A5" FontWeight="Bold" Margin="8,0,0,0" Click="SimulateFailover_Click" ToolTip="Simulates failure of selected active node to trigger automated standby takeover"/>
                    <Button Content="RESTORE / FAILBACK" Margin="8,0,0,0" Click="RestoreNode_Click" ToolTip="Restores a failed primary node back to nominal state"/>
                    <Button Content="RELEASE TO AUTO" Margin="8,0,0,0" Click="Release_Click" ToolTip="Release channel override back to automated N+M election"/>
                    <Button Content="INHIBIT OUTPUT" Margin="8,0,0,0" Click="Inhibit_Click"/>
                    <Button Content="ARM OUTPUT" Margin="8,0,0,0" Click="Arm_Click"/>
                    <Button Content="REMOVE NODE" Margin="8,0,0,0" Click="RemoveNode_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
