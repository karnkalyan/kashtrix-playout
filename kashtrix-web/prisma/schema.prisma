generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int                 @id @default(autoincrement())
  slug        String              @unique
  name        String
  tagline     String
  category    String
  summary     String              @db.Text
  description String              @db.LongText
  heroImage   String
  badge       String              @default("Professional Suite")
  accentColor String              @default("#8055B3")
  icon        String              @default("Tv")
  specs       String              @db.Text
  featured    Boolean             @default(true)
  order       Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  features    ProductFeature[]
  screenshots ProductScreenshot[]

  @@index([category])
  @@index([order])
}

model ProductFeature {
  id          Int      @id @default(autoincrement())
  productId   Int
  title       String
  description String   @db.Text
  icon        String   @default("CheckCircle")
  order       Int      @default(0)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductScreenshot {
  id          Int      @id @default(autoincrement())
  productId   Int
  title       String
  caption     String   @db.Text
  imagePath   String
  category    String   @default("Interface")
  order       Int      @default(0)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model HeroContent {
  id             Int      @id @default(autoincrement())
  badge          String
  title          String
  gradientTitle  String
  subtitle       String   @db.Text
  primaryCta     String   @default("Explore Playout")
  primaryCtaUrl  String   @default("/products/playout")
  secondaryCta   String   @default("Book Engineering Demo")
  secondaryCtaUrl String  @default("/contact")
  stats          String   @db.Text
  updatedAt      DateTime @updatedAt
}

model SiteSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String   @db.LongText
  updatedAt DateTime @updatedAt
}

model Inquiry {
  id             Int      @id @default(autoincrement())
  name           String
  email          String
  company        String?
  channelCount   String?
  productInterest String?
  message        String   @db.Text
  status         String   @default("new")
  createdAt      DateTime @default(now())
}

model Testimonial {
  id        Int      @id @default(autoincrement())
  author    String
  station   String
  role      String
  quote     String   @db.Text
  rating    Int      @default(5)
  order     Int      @default(0)
}
